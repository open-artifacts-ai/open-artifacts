{
  "name": "@oa/redline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "pnpm --filter @oa/provision build && vitest run",
    "live": "node --experimental-strip-types scripts/redline.ts",
    "provisioning": "node --experimental-strip-types --no-warnings scripts/provisioning.ts",
    "local": "node --experimental-strip-types scripts/local-pair.ts",
    "local:google": "REDLINE_LOCAL_MODE=google node --experimental-strip-types scripts/local-pair.ts",
    "local:t19": "REDLINE_LOCAL_T19=1 node --experimental-strip-types scripts/local-pair.ts",
    "t19:assets": "pnpm --filter @oa/server build",
    "typecheck": "pnpm --filter @oa/provision build && tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@oa/auth-core": "workspace:*",
    "@oa/dashboard": "workspace:*",
    "@oa/provisioner": "workspace:*",
    "@oa/provisioning": "workspace:*",
    "@oa/provisioning-contract": "workspace:*",
    "@oa/server": "workspace:*",
    "@oa/shared": "workspace:*",
    "@types/node": "^22.20.5",
    "tldts": "7.4.18",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@oa/provision": "workspace:*"
  }
}
