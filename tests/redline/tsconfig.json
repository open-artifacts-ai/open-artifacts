{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2022", "DOM"],
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "erasableSyntaxOnly": true
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "live/**/*.ts",
    "pending/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts",
    "vitest.live.config.ts"
  ],
  // Compiled by wrangler (esbuild) into fake-IdP builds only; it re-exports
  // @oa/auth-core's source, which this package's erasableSyntaxOnly rejects.
  "exclude": ["src/fake-idp/auth-core-shim.ts"]
}
