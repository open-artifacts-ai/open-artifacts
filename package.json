{
  "name": "open-artifacts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm --filter @oa/shared build && vitest run && pnpm -r --if-present test",
    "lint": "biome check .",
    "check-no-test-hooks": "node --experimental-strip-types scripts/ci/check-no-test-hooks.ts",
    "typecheck": "pnpm --filter @oa/shared build && tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "dev": "pnpm --parallel --filter @oa/server --filter @oa/dashboard --if-present dev",
    "oa:setup": "pnpm --filter @oa/setup start",
    "oa:hosted": "pnpm --silent --filter @oa/hosted start"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  },
  "version": "0.57.0"
}
