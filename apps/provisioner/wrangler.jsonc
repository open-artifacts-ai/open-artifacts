// Hosted provisioner Worker (self-serve step 3): consumes oa-<p>-signups,
// admits each signup under the daily cap (platform D1 `signups`, written
// pending by SS4) and starts one ProvisionInstall Workflow per signup id,
// which runs provision's WfpProvisioner.create. The owner's email is kept only
// in `signup_secret` (SS4 writes it).
//
// SIGNUPS_ENABLED is the on/off gate: "true" admits signups, "false" acks
// each message and leaves its row pending (prod stays "false" until the
// staging create and delete through hosted-ops has passed).
// Deploy with --env staging or --env prod only: the top level has no name and
// no main, so a deploy without --env is refused, even with --name. No routes,
// custom domains or workers.dev: the Worker has no fetch handler. Each env's
// ids, cap, sender, account and release are placeholders filled at deploy.
// Observability stays off: the Worker logs fixed categories and signup ids only.
// The provision token is the Secrets Store secret oa-<p>-provision-token,
// bound here and in no other Worker. Messages are { signupId } only, so the
// runtime dead-letter queue never holds an email, slug or sub.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "oa-s-provisioner",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "compatibility_flags": ["nodejs_compat"],
      // A create is ~300 ms of CPU; the headroom covers a slow release.
      "limits": { "cpu_ms": 300000 },
      "observability": { "enabled": false },
      "vars": {
        "SIGNUP_DAILY_CAP": "{{SIGNUP_DAILY_CAP_STAGING}}",
        // "true" admits signups; anything else acks them, rows left pending.
        "SIGNUPS_ENABLED": "{{SIGNUPS_ENABLED_STAGING}}",
        "WELCOME_FROM": "{{WELCOME_FROM_STAGING}}",
        "ACCOUNT_ID": "{{ACCOUNT_ID_STAGING}}",
        // The Workflow's env: it refuses any other value.
        "OA_ENV": "staging",
        // The release each signup's install is created at.
        "RELEASE_VERSION": "{{RELEASE_VERSION_STAGING}}"
      },
      "queues": {
        "consumers": [
          {
            "queue": "oa-s-signups",
            "max_batch_size": 1,
            "max_retries": 5,
            "dead_letter_queue": "oa-s-signups-dlq"
          }
        ]
      },
      "workflows": [
        {
          "name": "oa-s-provision-install",
          "binding": "PROVISION_INSTALL",
          "class_name": "ProvisionInstall"
        }
      ],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-s-platform",
          "database_id": "{{PLATFORM_DB_ID_STAGING}}"
        }
      ],
      "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "oa-s-releases" }],
      "send_email": [{ "name": "WELCOME_EMAIL" }],
      "secrets_store_secrets": [
        {
          "binding": "PROVISION_TOKEN",
          "store_id": "{{SECRETS_STORE_ID_STAGING}}",
          "secret_name": "oa-s-provision-token"
        }
      ]
    },
    "prod": {
      "name": "oa-p-provisioner",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "compatibility_flags": ["nodejs_compat"],
      // A create is ~300 ms of CPU; the headroom covers a slow release.
      "limits": { "cpu_ms": 300000 },
      "observability": { "enabled": false },
      "vars": {
        "SIGNUP_DAILY_CAP": "{{SIGNUP_DAILY_CAP_PROD}}",
        // "true" admits signups; anything else acks them, rows left pending.
        "SIGNUPS_ENABLED": "{{SIGNUPS_ENABLED_PROD}}",
        "WELCOME_FROM": "{{WELCOME_FROM_PROD}}",
        "ACCOUNT_ID": "{{ACCOUNT_ID_PROD}}",
        // The Workflow's env: it refuses any other value.
        "OA_ENV": "prod",
        // The release each signup's install is created at.
        "RELEASE_VERSION": "{{RELEASE_VERSION_PROD}}"
      },
      "queues": {
        "consumers": [
          {
            "queue": "oa-p-signups",
            "max_batch_size": 1,
            "max_retries": 5,
            "dead_letter_queue": "oa-p-signups-dlq"
          }
        ]
      },
      "workflows": [
        {
          "name": "oa-p-provision-install",
          "binding": "PROVISION_INSTALL",
          "class_name": "ProvisionInstall"
        }
      ],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-p-platform",
          "database_id": "{{PLATFORM_DB_ID_PROD}}"
        }
      ],
      "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "oa-p-releases" }],
      "send_email": [{ "name": "WELCOME_EMAIL" }],
      "secrets_store_secrets": [
        {
          "binding": "PROVISION_TOKEN",
          "store_id": "{{SECRETS_STORE_ID_PROD}}",
          "secret_name": "oa-p-provision-token"
        }
      ]
    }
  }
}
