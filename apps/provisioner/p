// Hosted provisioner Worker (design v7 2.1, 2.4): runs the ProvisionInstall
// and ManageInstall Workflows the Provisioning API (oa-<p>-provisioning)
// starts by job id, consumes oa-<p>-signups (self-serve: admits each signup
// under the daily cap, then starts its create job), and serves the
// ProvisionerRpc entrypoint (three read-only methods, 2.6). The API holds no
// Cloudflare token: this Worker re-checks every D1 row it is handed (2.5).
//
// SIGNUPS_ENABLED is the consumer's on/off gate: "true" admits signups,
// "test-users" (staging only) admits the ones the API let through, anything
// else acks each message and leaves its row pending.
// Deploy with --env staging or --env prod only: the top level has no name and
// no main, so a deploy without --env is refused, even with --name. No routes,
// custom domains or workers.dev: the Worker has no fetch handler. Each env's
// ids, cap, sender and account are placeholders filled at deploy; the release
// is a job argument, never a var.
// Observability stays off: the Worker logs fixed categories and ids only.
// The provision token is the Secrets Store secret oa-<p>-provision-token,
// bound here and in no other Worker (scripts/ops/deploy-platform-worker.sh
// refuses any other app that names it). Messages are { signupId } only, so
// the runtime dead-letter queue never holds an email, slug or sub.
// DISPATCHER reaches the install's script before any HOSTS mapping (5.2 f).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "oa-s-provisioner",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "compatibility_flags": ["nodejs_compat"],
      // A create is ~300 ms of CPU; the headroom covers a slow release.
      "limits": { "cpu_ms": 300000 },
      "observability": { "enabled": false },
      "vars": {
        "SIGNUP_DAILY_CAP": "{{SIGNUP_DAILY_CAP_STAGING}}",
        // "true" or "test-users" admits signups; anything else acks them.
        "SIGNUPS_ENABLED": "{{SIGNUPS_ENABLED_STAGING}}",
        "WELCOME_FROM": "{{WELCOME_FROM_STAGING}}",
        "ACCOUNT_ID": "{{ACCOUNT_ID_STAGING}}",
        // The Workflow's env: it refuses any other value.
        "OA_ENV": "staging",
        // The self-serve tier the recheck requires (2.5); the API's value.
        "SELF_SERVE_TIER": "trial"
      },
      "queues": {
        "consumers": [
          {
            "queue": "oa-s-signups",
            "max_batch_size": 1,
            "max_retries": 5,
            "dead_letter_queue": "oa-s-signups-dlq"
          }
        ]
      },
      "workflows": [
        {
          "name": "oa-s-provision-install",
          "binding": "PROVISION_INSTALL",
          "class_name": "ProvisionInstall"
        },
        {
          "name": "oa-s-manage-install",
          "binding": "MANAGE_INSTALL",
          "class_name": "ManageInstall"
        }
      ],
      "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "oa-staging" }],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-s-platform",
          "database_id": "{{PLATFORM_DB_ID_STAGING}}"
        }
      ],
      "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "oa-s-releases" }],
      "send_email": [{ "name": "WELCOME_EMAIL" }],
      "secrets_store_secrets": [
        {
          "binding": "PROVISION_TOKEN",
          "store_id": "{{SECRETS_STORE_ID_STAGING}}",
          "secret_name": "oa-s-provision-token"
        }
      ]
    },
    "prod": {
      "name": "oa-p-provisioner",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "compatibility_flags": ["nodejs_compat"],
      // A create is ~300 ms of CPU; the headroom covers a slow release.
      "limits": { "cpu_ms": 300000 },
      "observability": { "enabled": false },
      "vars": {
        "SIGNUP_DAILY_CAP": "{{SIGNUP_DAILY_CAP_PROD}}",
        // "true" admits signups; anything else acks them, rows left pending.
        "SIGNUPS_ENABLED": "{{SIGNUPS_ENABLED_PROD}}",
        "WELCOME_FROM": "{{WELCOME_FROM_PROD}}",
        "ACCOUNT_ID": "{{ACCOUNT_ID_PROD}}",
        // The Workflow's env: it refuses any other value.
        "OA_ENV": "prod",
        // The self-serve tier the recheck requires (2.5); the API's value.
        "SELF_SERVE_TIER": "trial"
      },
      "queues": {
        "consumers": [
          {
            "queue": "oa-p-signups",
            "max_batch_size": 1,
            "max_retries": 5,
            "dead_letter_queue": "oa-p-signups-dlq"
          }
        ]
      },
      "workflows": [
        {
          "name": "oa-p-provision-install",
          "binding": "PROVISION_INSTALL",
          "class_name": "ProvisionInstall"
        },
        {
          "name": "oa-p-manage-install",
          "binding": "MANAGE_INSTALL",
          "class_name": "ManageInstall"
        }
      ],
      "dispatch_namespaces": [{ "binding": "DISPATCHER", "namespace": "oa-prod" }],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-p-platform",
          "database_id": "{{PLATFORM_DB_ID_PROD}}"
        }
      ],
      "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "oa-p-releases" }],
      "send_email": [{ "name": "WELCOME_EMAIL" }],
      "secrets_store_secrets": [
        {
          "binding": "PROVISION_TOKEN",
          "store_id": "{{SECRETS_STORE_ID_PROD}}",
          "secret_name": "oa-p-provision-token"
        }
      ]
    }
  }
}
