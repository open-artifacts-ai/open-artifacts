// The read-only inventory Worker (red-line `GET /installs`, `GET /hosts`).
// Deploy with --env staging or --env prod only, through
// scripts/ops/deploy-platform-worker.sh (docs/ops/hosted.md): the top level has
// no name and no main, so a deploy without --env is refused. Each env's
// PLATFORM_DB and HOSTS ids have their own placeholder, filled at deploy (the
// ids of oa-<p>-platform and oa-<p>-hosts). Both bindings are read-only in
// code. INVENTORY_KEY is a secret, so it is not listed here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "oa-s-inventory",
      "main": "src/index.ts",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-s-platform",
          "database_id": "{{PLATFORM_DB_ID_STAGING}}"
        }
      ],
      "kv_namespaces": [{ "binding": "HOSTS", "id": "{{HOSTS_KV_ID_STAGING}}" }]
    },
    "prod": {
      "name": "oa-p-inventory",
      "main": "src/index.ts",
      "workers_dev": true,
      "preview_urls": false,
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-p-platform",
          "database_id": "{{PLATFORM_DB_ID_PROD}}"
        }
      ],
      "kv_namespaces": [{ "binding": "HOSTS", "id": "{{HOSTS_KV_ID_PROD}}" }]
    }
  }
}
