---
import { REPO_URL } from "@oa/shared";
import logo from "@oa/ui/brand/logo.svg";
import logoDark from "@oa/ui/brand/logo-dark.svg";
import tokensCss from "@oa/ui/tokens.css?raw";
import "@oa/ui/fonts.css";
import "../styles/site.css";
import rootPackage from "../../../../package.json";
import Todo from "../components/Todo.astro";
import { GATES, type GateId, UNRELEASED } from "../lib/release";

// Inline the Studio tokens without their font @import: the self-hosted Geist
// faces come from the fonts.css import above, which Astro bundles with the page CSS.
const fontImport = /^@import "\.\/fonts\.css";\n/m;
const tokens = tokensCss.replace(fontImport, "");

interface Props {
  title: string;
  description: string;
  /** Release-gate fallbacks this page depends on. */
  fallbacks?: GateId[];
}

const { title, description, fallbacks = [] } = Astro.props;
const active = fallbacks;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og.png", Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="oa-version" content={rootPackage.version} />
    <title>{title}</title>
    {active.length > 0 && <meta name="oa-status" content={UNRELEASED} />}
    {active.map((id) => <Todo text={GATES[id].todo} />)}
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:inline set:html={tokens} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Open Artifacts" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#eef0f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131518" media="(prefers-color-scheme: dark)" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-head">
      <div class="wrap head-row">
        <a class="wordmark" href="/">
          <picture>
            <source media="(prefers-color-scheme: dark)" srcset={logoDark.src} />
            <img src={logo.src} alt="Open Artifacts" width="124" height="22" />
          </picture>
        </a>
        <nav aria-label="Site">
          <a href="/docs/setup/">Docs</a>
          <a href="/llms.txt">llms.txt</a>
          <a href={REPO_URL}>GitHub</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-foot">
      <div class="wrap foot-row">
        <p>Open Artifacts is MIT licensed and runs on your own Cloudflare account.</p>
        <nav aria-label="Footer">
          <a href="/docs/setup/">Docs</a>
          <a href="/llms.txt">llms.txt</a>
          <a href={REPO_URL}>Source on GitHub</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
