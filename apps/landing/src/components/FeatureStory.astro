---
import { LIMITS } from "@oa/shared";
// A scroll-driven feature story: numbered features on the left, and on wide
// screens a sticky dashboard mock on the right that changes per feature. The
// mocks start inline under each feature (phones and no JS); on wide screens a
// script moves them into the sticky frame. Mocks are aria-hidden: the feature
// text carries the content.
import { formatBytes } from "../lib/limits";

const DOT = "·";
const CHECK = "✓";
const features = [
  {
    title: "Every agent, one library",
    body: "Whatever any AI agent publishes lands in your Library, labeled with the agent that made it. Search across all of it.",
  },
  {
    title: "Every version kept",
    body: "Each publish is a new version that records who and which agent made it. Open an older one and restore it in one click.",
  },
  {
    title: "Private until you share",
    body: "New artifacts are visible only to you. Share with people by email as viewer or editor, with your team, or by a public link that search engines skip.",
  },
  {
    title: "Self-hosted on your Cloudflare",
    body: "It runs on your own account and domain, behind Cloudflare Access login. Workers Free fits one person; Workers Paid fits a team.",
  },
];
const cards = [
  {
    title: "Q4 data migration plan",
    kind: "MD",
    from: "Claude Code",
    thumb: ["Freeze writes, Oct 28", "Backfill, Nov 4", "Cut over, Nov 18"],
  },
  {
    title: "Offsite location poll",
    kind: "HTML",
    from: "Cursor",
    thumb: ["Lisbon 6", "Mexico City 4", "Montreal 2"],
  },
  {
    title: "backfill.py",
    kind: "Code",
    from: "Codex",
    thumb: [
      "def backfill(conn):",
      "  for ids in chunks():",
      "    conn.execute(...)",
    ],
  },
  {
    title: "Vendor agreement.pdf",
    kind: "PDF",
    from: "OpenCode",
    thumb: ["Vendor agreement", "Northwind Eng and", "Acme Data, Nov 1"],
  },
];
const versions = [
  ["v3", "Claude Code", "2 min ago", "Current"],
  ["v2", "Cursor", "1 hour ago", ""],
  ["v1", "Codex", "Yesterday", ""],
];
const plans = [
  [
    "Largest MCP publish",
    formatBytes(LIMITS.mcpBodyBytesFree),
    formatBytes(LIMITS.mcpBodyBytesPaid),
  ],
  [
    "Live data doc",
    formatBytes(LIMITS.dataDocBytesFree),
    formatBytes(LIMITS.dataDocBytesPaid),
  ],
  ["Invite emails", "No", "Yes"],
];
---

<div class="story" data-story>
  <ol class="story-list">
    {
      features.map((f, i) => (
        <li class="story-item" data-i={i}>
          <p class="story-n mono" aria-hidden="true">{String(i + 1).padStart(2, "0")}</p>
          <h3>{f.title}</h3>
          <p class="story-body">{f.body}</p>
          <span class="story-bar" aria-hidden="true"><i></i></span>
          <div class="story-slot" aria-hidden="true">
            <div class="scene" data-scene={i}>
              {i === 0 && (
                <div class="sc-lib">
                  <p class="sc-head">Library <span>{cards.length} new</span></p>
                  <ul class="sc-cards">
                    {cards.map((c, n) => (
                      <li style={`--n:${n}`}>
                        <span class="sc-thumb mono">{c.thumb.map((t) => <span>{t}</span>)}</span>
                        <span class="sc-title">{c.title}</span>
                        <span class="sc-meta">
                          <span class="sc-kind mono">{c.kind}</span>
                          <span class="sc-from">From {c.from}</span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {i === 1 && (
                <div class="sc-ver">
                  <div class="sc-doc">
                    <p class="sc-banner">
                      Viewing v2 from Cursor <span class="sc-btn">Restore this version</span>
                    </p>
                    <p class="sc-doc-h">Q4 data migration plan</p>
                    <p>Freeze writes on the old tables on Oct 28, then backfill in batches of 5,000.</p>
                  </div>
                  <ul class="sc-versions">
                    <li class="sc-vh">Versions</li>
                    {versions.map(([v, who, when, tag]) => (
                      <li class:list={[{ on: v === "v2" }]}>
                        <b>{v}</b> {who}
                        <span>
                          {when}
                          {tag && ` ${DOT} ${tag}`}
                        </span>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {i === 2 && (
                <div class="sc-share">
                  <p class="sc-head">Share "Q4 data migration plan"</p>
                  <ul class="sc-vis">
                    <li class="on">
                      <b>Private</b> Only you <span class="sc-tag">Default</span>
                    </li>
                    <li>
                      <b>Team</b> Everyone on your team
                    </li>
                    <li>
                      <b>Public link</b> Anyone with the link, never indexed
                    </li>
                  </ul>
                  <ul class="sc-people">
                    <li>
                      <span class="sc-av">MC</span> Maya Chen <span class="sc-role">Editor</span>
                    </li>
                    <li>
                      <span class="sc-av">SO</span> Sam Ortiz <span class="sc-role">Viewer</span>
                    </li>
                  </ul>
                  <p class="sc-link">
                    <span class="mono">artifacts.yourco.com/a/Rm2x9C</span>
                    <span class="sc-copied">Link copied {CHECK}</span>
                  </p>
                </div>
              )}
              {i === 3 && (
                <div class="sc-host">
                  <div class="sc-signin">
                    <p class="sc-cf mono">Cloudflare Access</p>
                    <p class="sc-head">Log in to artifacts.yourco.com</p>
                    <span class="sc-btn">Email me a one-time PIN</span>
                    <span class="sc-btn ghost">Continue with GitHub</span>
                    <span class="sc-btn ghost">Continue with Google</span>
                  </div>
                  <table class="sc-plans">
                    <thead>
                      <tr>
                        <th></th>
                        <th>Workers Free</th>
                        <th>Workers Paid</th>
                      </tr>
                    </thead>
                    <tbody>
                      {plans.map(([k, free, paid]) => (
                        <tr>
                          <th>{k}</th>
                          <td>{free}</td>
                          <td>{paid}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}
            </div>
          </div>
        </li>
      ))
    }
  </ol>

  <div class="story-stage" aria-hidden="true">
    <div class="dash">
      <div class="dash-side">
        <p class="dash-brand">Open Artifacts</p>
        <p class="dash-nav on">Library</p>
        <p class="dash-nav">Shared with me</p>
        <p class="dash-nav">Settings</p>
        <p class="dash-sub">Agents</p>
        <p class="dash-nav">Claude Code</p>
        <p class="dash-nav">Codex</p>
        <p class="dash-nav">Cursor</p>
        <p class="dash-nav">OpenCode</p>
      </div>
      <div class="dash-main" data-stage></div>
    </div>
  </div>
</div>

<style>
  .story {
    margin-top: 24px;
  }
  .story-list {
    display: grid;
    gap: 40px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .story-n {
    color: var(--oa-accent-fg);
    font-size: var(--oa-text-sm);
    font-weight: 500;
  }
  .story-item h3 {
    margin-top: 4px;
    font-size: var(--oa-text-xl);
  }
  .story-body {
    max-width: 46ch;
    margin-top: 6px;
    color: var(--oa-text-2);
  }
  .story-bar {
    display: none;
  }
  .story-slot {
    margin-top: 16px;
  }
  .story-stage {
    display: none;
  }

  /* Wide screens with JS: sticky frame on the right, features scroll past. */
  .story.live {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: 48px;
  }
  .story.live .story-list {
    gap: 0;
  }
  .story.live .story-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 62vh;
  }
  .story.live .story-n {
    color: var(--oa-text-muted);
  }
  .story.live .on .story-n {
    color: var(--oa-accent-fg);
  }
  .story.live .story-slot {
    display: none;
  }
  .story.live .story-bar {
    display: block;
    width: 160px;
    height: 3px;
    margin-top: 16px;
    border-radius: 2px;
    background: var(--oa-divider);
    overflow: hidden;
  }
  .story-bar i {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--oa-accent);
    transform-origin: left;
    transform: scaleX(var(--p, 0));
  }
  .story.live .story-stage {
    display: block;
    position: sticky;
    top: calc(50vh - 220px);
    align-self: start;
    margin-top: calc(31vh - 220px);
  }
  .dash {
    display: grid;
    grid-template-columns: 150px 1fr;
    height: 440px;
    overflow: hidden;
    border-radius: var(--oa-radius-lg);
    background: var(--oa-bg);
    box-shadow: var(--oa-shadow-2);
    font-size: var(--oa-text-sm);
  }
  .dash-side {
    padding: 14px 10px;
    border-right: 1px solid var(--oa-divider);
    background: var(--oa-chrome);
    color: var(--oa-text-2);
  }
  .dash-brand {
    margin: 0 6px 12px;
    color: var(--oa-text);
    font-weight: 600;
  }
  .dash-nav {
    padding: 4px 8px;
    border-radius: var(--oa-radius-md);
  }
  .dash-nav.on {
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-1);
    color: var(--oa-text);
  }
  .dash-sub {
    margin: 14px 8px 4px;
    color: var(--oa-text-muted);
    font-size: var(--oa-text-xs);
  }
  .dash-main {
    position: relative;
    min-width: 0;
  }
  .story.live .scene {
    position: absolute;
    inset: 0;
    padding: 18px;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 280ms var(--oa-ease),
      visibility 0s 280ms;
  }
  .story.live .scene.on {
    opacity: 1;
    visibility: visible;
    transition: opacity 280ms var(--oa-ease);
  }

  /* Scenes. Inline (phones), each sits in its own small frame. */
  .scene {
    padding: 14px;
    border-radius: var(--oa-radius-lg);
    background: var(--oa-bg);
    box-shadow: var(--oa-shadow-1);
    font-size: var(--oa-text-sm);
  }
  .story.live .scene {
    border-radius: 0;
    background: none;
    box-shadow: none;
  }
  .sc-head {
    font-weight: 600;
  }
  .sc-head span {
    margin-left: 6px;
    color: var(--oa-text-muted);
    font-weight: 400;
  }
  .sc-cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 10px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .sc-cards li {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 8px;
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-1);
  }
  .story.live .scene .sc-cards li {
    opacity: 0;
    transform: translateY(-14px);
  }
  .story.live .scene.on .sc-cards li {
    opacity: 1;
    transform: none;
    transition:
      opacity 360ms var(--oa-ease),
      transform 360ms var(--oa-ease);
    transition-delay: calc(var(--n) * 140ms);
  }
  .sc-thumb {
    display: grid;
    gap: 1px;
    padding: 8px;
    border-radius: var(--oa-radius-sm);
    background: var(--oa-sunken);
    color: var(--oa-text-2);
    font-size: 10px;
    line-height: 1.4;
    white-space: nowrap;
    overflow: hidden;
  }
  .sc-thumb span:first-child {
    color: var(--oa-text);
    font-weight: 500;
  }
  .sc-title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 500;
  }
  .sc-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    align-items: center;
  }
  .sc-kind {
    color: var(--oa-text-muted);
    font-size: 10px;
  }
  .sc-from {
    padding: 1px 6px;
    border-radius: var(--oa-radius-sm);
    background: var(--oa-accent-soft);
    color: var(--oa-accent-fg);
    font-size: 11px;
    font-weight: 500;
  }

  .sc-ver {
    display: grid;
    gap: 10px;
  }
  @media (min-width: 560px) {
    .sc-ver {
      grid-template-columns: 1fr 170px;
    }
  }
  .sc-doc {
    padding: 12px;
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-1);
    color: var(--oa-text-2);
  }
  .sc-banner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    margin-bottom: 10px;
    padding: 6px 8px;
    border-radius: var(--oa-radius-sm);
    background: var(--oa-warning-soft);
    color: var(--oa-text);
    font-size: var(--oa-text-xs);
  }
  .sc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px 10px;
    border-radius: var(--oa-radius-sm);
    background: var(--oa-text);
    color: var(--oa-surface);
    font-size: var(--oa-text-xs);
    font-weight: 500;
  }
  .sc-btn.ghost {
    border: 1px solid var(--oa-border);
    background: var(--oa-surface);
    color: var(--oa-text);
  }
  .sc-doc-h {
    color: var(--oa-text);
    font-size: var(--oa-text-lg);
    font-weight: 600;
  }
  .sc-versions,
  .sc-vis,
  .sc-people {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sc-versions li {
    display: grid;
    padding: 6px 8px;
    border-radius: var(--oa-radius-md);
    color: var(--oa-text-2);
  }
  .sc-versions li span {
    color: var(--oa-text-muted);
    font-size: var(--oa-text-xs);
  }
  .sc-versions .sc-vh {
    color: var(--oa-text);
    font-weight: 600;
  }
  .sc-versions li.on {
    background: var(--oa-surface);
    box-shadow: 0 0 0 1px var(--oa-accent);
  }

  .sc-share {
    display: grid;
    gap: 10px;
    padding: 14px;
    border-radius: var(--oa-radius-lg);
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-2);
  }
  .sc-vis li {
    padding: 6px 8px;
    border: 1px solid var(--oa-divider);
    border-radius: var(--oa-radius-md);
    color: var(--oa-text-muted);
  }
  .sc-vis b {
    margin-right: 6px;
    color: var(--oa-text);
    font-weight: 500;
  }
  .sc-vis li.on {
    border-color: var(--oa-accent);
  }
  .sc-tag {
    float: right;
    color: var(--oa-accent-fg);
    font-size: var(--oa-text-xs);
  }
  .sc-people li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .sc-av {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--oa-accent-soft);
    color: var(--oa-accent-fg);
    font-size: 10px;
    font-weight: 600;
  }
  .sc-role {
    margin-left: auto;
    color: var(--oa-text-muted);
  }
  .sc-link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
    padding: 6px 8px;
    border-radius: var(--oa-radius-md);
    background: var(--oa-sunken);
    font-size: var(--oa-text-xs);
  }
  .sc-copied {
    color: var(--oa-success-fg);
    font-weight: 500;
  }

  .sc-host {
    display: grid;
    gap: 12px;
  }
  @media (min-width: 560px) {
    .sc-host {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }
  }
  .sc-signin {
    display: grid;
    gap: 6px;
    padding: 14px;
    border-radius: var(--oa-radius-lg);
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-2);
  }
  .sc-cf {
    color: var(--oa-warning);
    font-size: 10px;
  }
  .sc-plans {
    border-collapse: collapse;
    font-size: var(--oa-text-xs);
  }
  .sc-plans th,
  .sc-plans td {
    padding: 6px;
    border-bottom: 1px solid var(--oa-divider);
    text-align: left;
    font-weight: 400;
  }
  .sc-plans thead th {
    color: var(--oa-text);
    font-weight: 600;
  }
  .sc-plans tbody th {
    color: var(--oa-text-muted);
  }
  /* Phones: trim each inline mock to its point so the section stays short. */
  @media (max-width: 559px) {
    .sc-thumb,
    .sc-people,
    .sc-signin .ghost + .ghost {
      display: none;
    }
    .sc-versions li {
      display: flex;
      flex-wrap: wrap;
      gap: 0 6px;
      padding: 4px 8px;
    }
    .sc-doc p:last-child {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .story *,
    .story.live .scene.on .sc-cards li {
      transition: none !important;
    }
  }
</style>

<script>
  const story = document.querySelector<HTMLElement>("[data-story]");
  const stage = story?.querySelector<HTMLElement>("[data-stage]");
  if (story && stage) {
    const wide = matchMedia("(min-width: 960px)");
    const items = [...story.querySelectorAll<HTMLElement>(".story-item")];
    const scenes = items.map((it) => it.querySelector<HTMLElement>(".scene"));
    let frame = 0;
    let active = -1;

    const update = () => {
      frame = 0;
      const mid = innerHeight / 2;
      let i = 0;
      items.forEach((it, n) => {
        if (it.getBoundingClientRect().top <= mid) i = n;
      });
      const r = items[i].getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (mid - r.top) / r.height));
      items[i].style.setProperty("--p", String(p));
      if (i === active) return;
      active = i;
      items.forEach((it, n) => {
        it.classList.toggle("on", n === i);
        scenes[n]?.classList.toggle("on", n === i);
        if (n !== i) it.style.setProperty("--p", n < i ? "1" : "0");
      });
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };
    const layout = () => {
      // Wide screens: one sticky frame. Otherwise each mock sits under its text.
      items.forEach((it, n) => {
        const scene = scenes[n];
        if (scene) (wide.matches ? stage : it.querySelector(".story-slot"))?.append(scene);
      });
      story.classList.toggle("live", wide.matches);
      active = -1;
      if (wide.matches) update();
    };
    let watching = false;
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting === watching) return;
      watching = e.isIntersecting;
      if (watching) addEventListener("scroll", onScroll, { passive: true });
      else removeEventListener("scroll", onScroll);
    }).observe(story);
    wide.addEventListener("change", layout);
    layout();
  }
</script>
