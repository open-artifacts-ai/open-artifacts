---
// The landing page body (#1457): hero with a demo, a scroll story, the agents
// it works with, pricing, self-host and the close. Everything renders in its
// landed state in HTML; home.client.ts enhances it.
import { REPO_URL } from "@oa/shared";
import { signupHref } from "../../lib/hero";
import Agents from "./Agents.astro";
import BeforeAfter from "./BeforeAfter.astro";
import Pricing from "./Pricing.astro";
import Scene from "./Scene.astro";
import SideBySide from "./SideBySide.astro";
import Story from "./Story.astro";
import "./home.css";

// The two picks the page waits on. Each is a one-line change.
// HERO: "scroll" (a pinned scene in four moments), "static" (a transcript
// scrolling beside the artifact), "questions" (the interactive before/after
// with three question chips) or "plain" (no demo).
// HEADLINE: "stop", "bad" or "coding".
const HERO = "scroll" as "scroll" | "static" | "questions" | "plain";
const HEADLINE = "stop" as "stop" | "bad" | "coding";

const HEADLINES = {
  stop: "Stop reading transcripts.",
  bad: "Transcripts are a bad place to do work.",
  coding: "Coding agent transcripts are a bad place to do work.",
};
const words = { h1: HEADLINES[HEADLINE] };

const signup = signupHref(import.meta.env.HOSTED_SIGNUP_URL);
const prompt = "install open-artifacts.com/llms.txt";
const [promptLead, promptUrl] = prompt.split(/(?<=install )/);
const cue = "Scroll to follow one artifact through its first week.";
---
<div class="lp" id="lp" data-hl={HEADLINE} data-hero={HERO}>
  <header class="hero" id="top"><div class="wrap">
    <p class="x-eb">For people and agents, on any model</p>
    <h1>{words.h1}</h1>
    <p class="lede">Your agents put their work in an artifact. Your team reads it, comments and decides, right where the work is. Works with Claude, Codex, Gemini or any agent.</p>
    <div class="btns"><a class="btn p" href={signup}>Start free for 30 days</a><a class="btn" href="#self-host">Self-host it</a></div>
    <p class="fine">No card needed. Then $1 a month. Open source, MIT licensed.</p>
    {HERO === "plain" && <p class="cue"><i aria-hidden="true"></i>{cue}</p>}
  </div>
  {HERO === "scroll" && <Scene />}
  {HERO === "static" && <SideBySide />}
  {HERO === "questions" && <BeforeAfter />}
  </header>

  <Story cue={HERO !== "plain"} scripted={HERO === "plain"} />

  <Agents />

  <Pricing signup={signup} />

  <section class="x-sec x-band" id="self-host" aria-labelledby="steps-h"><div class="wrap">
    <h2 id="steps-h">Self-host in three steps.</h2>
    <ol class="x-steps">
      <li>
        <h3>Tell your agent</h3>
        <p>Your agent reads llms.txt, checks the prerequisites, clones the latest release, and runs pnpm install.</p>
        <span class="step-chip mono" aria-hidden="true"><span class="caret">{"›"}</span><span>{promptLead}<span class="nowrap">{promptUrl}</span></span></span>
      </li>
      <li>
        <h3>Sign in to Cloudflare</h3>
        <p>One step needs you: <code>npx wrangler login</code>. Setup then creates D1, R2 and KV and the Access sign-in app, deploys to both domains, and adds the MCP server to your agent.</p>
        <span class="step-chip" aria-hidden="true">Allow Wrangler to manage your account? <span class="mini-btn">Allow</span></span>
      </li>
      <li>
        <h3>Publish and share</h3>
        <p>Your agent publishes a Welcome artifact and gives you the link. Later, ask it to write up the Q4 data migration plan and share it with a teammate.</p>
        <span class="step-chip" aria-hidden="true"><span class="mono">artifacts.example.com/a/7Hq3…</span><span class="badge team">Team</span></span>
      </li>
    </ol>
  </div></section>

  <section class="x-sec x-close" aria-labelledby="close-h"><div class="wrap">
    <h2 id="close-h" class="x-cl">Where people and agents <br />come to do their best work, <br />together.</h2>
    <p class="x-lede">Give your agents somewhere better to put their work.</p>
    <div class="btns"><a class="btn p" href={signup}>Start free for 30 days</a><a class="btn" href={REPO_URL}>View on GitHub</a></div>
  </div></section>
</div>

<script>
  import "./home.client";
</script>
