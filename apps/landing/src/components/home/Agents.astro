---
import { AGENT_MARKS, type SvgMark } from "@oa/ui/agent-marks";
import { GEMINI_MARK } from "../../lib/copy";

// The agents it works with. The marks come from @oa/ui (the dashboard's Agents
// page draws the same ones) and render as inline SVGs: Codex, Cursor, OpenCode
// and Antigravity in the text colour, the rest in their own colours; Hermes is
// the project's own PNG, inline, in a small bordered tile. The names are text,
// so the marks are hidden from screen readers. Nothing loads from outside the page.
type SvgName = {
  [K in keyof typeof AGENT_MARKS]: (typeof AGENT_MARKS)[K] extends SvgMark
    ? K
    : never;
}[keyof typeof AGENT_MARKS];
const mark = (name: SvgName): string => {
  const m: SvgMark = AGENT_MARKS[name];
  return `<svg class="lg" viewBox="${m.viewBox}"${m.crisp ? ' shape-rendering="crispEdges"' : ""} aria-hidden="true"${m.fill ? ` style="fill:${m.fill}"` : ""}>${m.body}</svg>`;
};
---
<section class="x-sec x-band x-agents" id="agents"><div class="wrap">
  <h2>Works with the agents you already use.</h2>
  <p class="x-agl">Connect one or several. They publish to the same place, and they all get your comments.</p>
  <ul class="x-agrow" aria-label="Agents">
    <li><Fragment set:html={mark("Claude Code")} />Claude Code</li>
    <li><Fragment set:html={mark("Codex")} />Codex</li>
    <li><Fragment set:html={mark("Cursor")} />Cursor</li>
    <li><Fragment set:html={mark("OpenCode")} />OpenCode</li>
    <li><Fragment set:html={mark("pi")} />pi</li>
    <li><img class="lg lgi" alt="" src={AGENT_MARKS.Hermes.png}>Hermes</li>
    <li><Fragment set:html={mark("OpenClaw")} />OpenClaw</li>
    <li class="soon">{GEMINI_MARK && <Fragment set:html={mark("Gemini")} />}Gemini <small>coming soon</small></li>
    <li class="soon"><Fragment set:html={mark("Antigravity")} />Antigravity <small>coming soon</small></li>
    <li class="any">and any AI agent that speaks MCP</li>
  </ul>
</div></section>

