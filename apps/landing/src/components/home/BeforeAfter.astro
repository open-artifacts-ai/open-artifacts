---
import { ARTIFACT_STATUS, lines, transcriptStatus } from "../../lib/transcript";
import Agent from "./Agent.astro";

// Rendered in its landed state (the first question, the Claude Code look) so
// the page reads with scripts off; the script plays and redraws it.
const ls = lines("claude");
const status = transcriptStatus("dec", ls);
const questions = [
  { q: "dec", label: "What did we decide?" },
  { q: "chg", label: "What changed?" },
  { q: "team", label: "What does the team think?" },
];
---
<div class="wrap x-ba" id="ba" data-show="tr" data-q="dec">
  <div class="x-bahead">
    <p class="x-bah" id="bah">Same work, two places. Pick a question:</p>
    <div class="x-qs" role="group" aria-labelledby="bah">
      {questions.map((c) => <button type="button" data-q={c.q} aria-pressed={c.q === "dec" ? "true" : "false"}>{c.label}</button>)}
    </div>
  </div>
  <div class="x-flip x-seg" role="group" aria-label="Which side to show">
    <button type="button" data-side="tr" aria-pressed="true">Before</button>
    <button type="button" data-side="ar" aria-pressed="false">After</button>
  </div>
  <div class="x-sides">
    <figure class="x-side x-tr">
      <figcaption><b>In a transcript</b><span class="x-stat" id="trstat" role="status">{status}</span></figcaption>
      <div class="x-term" id="term" data-look="claude">
        <div class="x-tbar">
          <span class="x-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          <span id="tname">claude</span>
          <span class="x-seg x-look" role="group" aria-label="Transcript from">
            <button type="button" data-look="claude" aria-pressed="true">Claude Code</button>
            <button type="button" data-look="codex" aria-pressed="false">Codex</button>
          </span>
        </div>
        <div class="x-scroll" id="trs" tabindex="0" role="region" aria-label="An agent transcript">
          <p class="none">Nothing from your team in here. They never saw this chat.</p>
          {ls.map((l) => (
            <p class:list={[l.cls, { hit: l.tag === "dec" }]} data-tag={l.tag}>{l.text}{l.sub && <span class="sub">{l.sub}</span>}</p>
          ))}
        </div>
      </div>
    </figure>
    <figure class="x-side x-ar">
      <figcaption><b>In an artifact</b><span class="x-stat ok" id="arstat" role="status">{ARTIFACT_STATUS.dec}</span></figcaption>
      <div class="x-art">
        <div class="x-abar">
          <span class="t">Agents page plan</span><span class="chip">Shared with 4</span><span class="x-sp"></span>
          <span class="pp" aria-hidden="true">SR</span><span class="pp" aria-hidden="true">MC</span><Agent /><span class="chip ver">v12</span>
        </div>
        <div class="x-abody">
          <div class="x-blk hit" id="b-dec"><h4>Decision</h4><p class="x-dec"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg><span>List and detail, side by side.</span></p><p class="x-sub">You picked it on Tuesday, from your phone.</p></div>
          <div class="x-blk" id="b-chg"><h4>What changed in v12</h4><ul class="x-chg"><li>The list shows each agent's status.</li><li>On a phone, the detail opens as a sheet.</li><li>Tests cover both layouts.</li></ul></div>
          <div class="x-blk" id="b-team"><h4>Comments</h4>
            <div class="x-cm"><span class="pp" aria-hidden="true">SR</span><p><b>Sam Rivera</b>Can the list show status too?</p></div>
            <div class="x-cm"><Agent /><p><b>OA Product <span class="x-tag">agent</span></b>Added. It's in v12.</p></div>
            <div class="x-cm"><span class="pp" aria-hidden="true">MC</span><p><b>Maya Chen</b>The sheet works well on my phone.</p></div>
          </div>
        </div>
      </div>
    </figure>
  </div>
  <p class="x-note">The agent replies in these demos are scripted.</p>
</div>
