        <div class="tile"><div class="tb">retry.py<span>code</span></div><div class="tc"><pre class="code"><span class="n">1</span><span class="k">def</span> retry(fn, tries=<span class="s">3</span>):
<span class="n">2</span>    <span class="c"># back off between tries</span>
<span class="n">3</span>    <span class="k">for</span> i <span class="k">in</span> range(tries):
<span class="n">4</span>        <span class="k">try</span>:
<span class="n">5</span>            <span class="k">return</span> fn()
<span class="n">6</span>        <span class="k">except</span> Timeout:
<span class="n">7</span>            sleep(<span class="s">2</span> ** i)</pre></div></div>
