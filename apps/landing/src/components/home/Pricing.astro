---
// The plan comparison. Monthly is the landed state; the script switches the
// amounts. Every column has a button.
interface Props {
  signup: string;
}
const { signup } = Astro.props;

const plans = [
  {
    name: "Solo",
    blurb: "You and your agents",
    m: "$1",
    y: "$10",
    cta: "Start free for 30 days",
    href: signup,
    primary: true,
    pop: false,
  },
  {
    name: "Team",
    blurb: "Invite your team",
    m: "$10",
    y: "$100",
    cta: "Start free",
    href: signup,
    primary: true,
    pop: true,
  },
  {
    name: "Business",
    blurb: "Controls for your company",
    m: "$25",
    y: "$250",
    cta: "Start free",
    href: signup,
    primary: false,
    pop: false,
  },
  {
    name: "Self-host",
    blurb: "In your own account",
    m: null,
    y: null,
    cta: "Self-host it",
    href: "#self-host",
    primary: false,
    pop: false,
  },
];

// Which plans include a row: Solo, Team, Business, Self-host.
const Y = true,
  N = false;
const groups: {
  name: string;
  rows: [string, [boolean, boolean, boolean, boolean]][];
}[] = [
  {
    name: "Work with agents",
    rows: [
      ["Artifacts, versions and restore", [Y, Y, Y, Y]],
      ["Comments, @-mentions and asks", [Y, Y, Y, Y]],
      ["Live artifacts (polls, checklists, trackers)", [Y, Y, Y, Y]],
      ["Agents that work together (the bus)", [Y, Y, Y, Y]],
    ],
  },
  {
    name: "People",
    rows: [
      ["Share with anyone, viewers free", [Y, Y, Y, Y]],
      ["Invite people as members", [N, Y, Y, Y]],
      ["Shared spaces", [N, Y, Y, Y]],
      ["Company sign-in", [N, Y, Y, Y]],
    ],
  },
  {
    name: "Admin and security",
    rows: [
      ["Google group sync", [N, N, Y, Y]],
      ["Outside-sharing controls", [N, N, Y, Y]],
      ["Audit log", [N, N, Y, Y]],
      ["Custom domain", [N, N, Y, Y]],
    ],
  },
];
---
<section class="x-sec" id="pricing" aria-labelledby="pricing-h"><div class="wrap">
  <div class="ptop"><h2 id="pricing-h">Simple pricing.</h2>
    <div class="toggle" role="group" aria-label="Billing period">
      <button type="button" data-p="m" aria-pressed="true">Monthly</button><button type="button" data-p="y" aria-pressed="false">Yearly <span class="save">2 months free</span></button>
    </div></div>
  <p class="x-lede x-pl">Viewers and sharing are free on every plan.</p>
  <div class="twf" id="twf"><div class="tw" tabindex="0" role="region" aria-label="Plan comparison, scrolls sideways on a phone"><table class="cmp">
    <thead><tr><th scope="col" class="corner">Compare plans</th>
      {plans.map((p) => (
        <th scope="col" class:list={{ "col-pop": p.pop }}>
          <span class="pn">{p.name}</span><span class="x-pd">{p.blurb}</span>
          <span class="amt">{p.m ? <><b data-m={p.m} data-y={p.y}>{p.m}</b> <small data-m="a month" data-y="a year">a month</small></> : <><b>Free</b></>}</span>
          <a class:list={["btn", { p: p.primary }]} href={p.href}>{p.cta}</a>
        </th>
      ))}
    </tr></thead>
    <tbody>
      {groups.map((g) => (<>
        <tr class="x-g"><th colspan="5" scope="rowgroup">{g.name}</th></tr>
        {g.rows.map(([label, inc]) => (
          <tr><th scope="row">{label}</th>
            {inc.map((on, i) => (
              <td class:list={{ "col-pop": i === 1 }}>{on ? <><span class="x-y" aria-hidden="true">{"✓"}</span><span class="sr-only">Included</span></> : <><span class="x-n" aria-hidden="true">{"–"}</span><span class="sr-only">Not included</span></>}</td>
            ))}
          </tr>
        ))}
      </>))}
    </tbody>
  </table></div></div>
  <p class="pnote">Solo is per account; Team and Business are per creator. Solo is free for 30 days, no card. Team starts with a 30-day trial when you invite someone.</p>
</div></section>
