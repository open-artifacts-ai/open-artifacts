---
// The plan comparison. Yearly is the landed state (so it is what scripts-off
// readers see); the script switches the amounts. Every column has a button.
import { PLAN_LIST, priceStrings, WORDS } from "../../lib/pricing";

interface Props {
  signup: string;
}
const { signup } = Astro.props;

const CTAS = [
  "Get started free",
  "Get started free",
  "Get started free",
  "Self-host it",
];
const plans = PLAN_LIST.map((p, i) => ({
  ...p,
  cta: CTAS[i],
  href: p.monthly ? signup : "#self-host",
  strings: p.monthly ? priceStrings(p) : null,
}));

// Which plans include a row: Solo, Team, Business, Self-host. "S" is a feature
// that is not there yet and shows "Soon".
const Y = true,
  N = false,
  S = "soon";
type Cell = boolean | "soon";
const groups: {
  name: string;
  rows: [string, [Cell, Cell, Cell, Cell]][];
}[] = [
  {
    name: "Work with agents",
    rows: [
      ["Artifacts, versions and restore", [Y, Y, Y, Y]],
      ["Comments and @-mentions", [Y, Y, Y, Y]],
      ["Live artifacts (polls, checklists, trackers)", [Y, Y, Y, Y]],
      ["Agents that work together (the bus)", [Y, Y, Y, Y]],
      ["Asks: your agent asks, you pick", [Y, Y, Y, Y]],
      ["Decisions kept on every page", [Y, Y, Y, Y]],
      ["Teammates decide and weigh in", [N, Y, Y, Y]],
    ],
  },
  {
    name: "People",
    rows: [
      ["Share with anyone, viewers free", [Y, Y, Y, Y]],
      ["Invite people as members", [N, Y, Y, Y]],
      ["Shared spaces", [N, Y, Y, Y]],
      ["Company login", [N, Y, Y, Y]],
    ],
  },
  {
    name: "Admin and security",
    rows: [
      ["Google group sync", [N, N, Y, Y]],
      ["Outside-sharing controls", [N, N, Y, Y]],
      ["Audit log", [N, N, S, S]],
      ["Custom domain", [N, N, S, Y]],
    ],
  },
];
---
<section class="x-sec" id="pricing" aria-labelledby="pricing-h"><div class="wrap">
  <div class="ptop"><h2 id="pricing-h">Simple pricing.</h2>
    <div class="toggle" role="group" aria-label="Billing period">
      <button type="button" data-p="m" aria-pressed="false">Monthly</button><button type="button" data-p="y" aria-pressed="true">Yearly <span class="save">2 months free</span></button>
    </div></div>
  <p class="x-lede x-pl">Viewers and sharing are free on every plan.</p>
  <div class="twf" id="twf"><div class="tw" tabindex="0" role="region" aria-label="Plan comparison, scrolls sideways on a phone"><table class="cmp">
    <thead><tr><th scope="col" class="corner">Compare plans</th>
      {plans.map((p) => (
        <th scope="col" class:list={{ "col-pop": p.pop }}>
          <span class="pn">{p.name}</span><span class="x-pd">{p.blurb}</span>
          <span class="amt">{p.strings ? <><b data-m={p.strings.price.m} data-y={p.strings.price.y}>{p.strings.price.y}</b> <small>{p.strings.unit}</small><i class="bill" data-m={p.strings.bill.m} data-y={p.strings.bill.y}>{p.strings.bill.y}</i></> : <><b>Free</b> <small>&nbsp;</small><i class="bill">{WORDS.selfHost}</i></>}</span>
          <a class:list={["btn", { p: p.primary }]} href={p.href}>{p.cta}</a>
        </th>
      ))}
    </tr></thead>
    <tbody>
      {groups.map((g) => (<>
        <tr class="x-g"><th colspan="5" scope="rowgroup">{g.name}</th></tr>
        {g.rows.map(([label, inc]) => (
          <tr><th scope="row">{label}</th>
            {inc.map((on, i) => (
              <td class:list={{ "col-pop": i === 1 }}>{on === "soon" ? <><span class="x-n" aria-hidden="true">Soon</span><span class="sr-only">Coming soon</span></> : on ? <><span class="x-y" aria-hidden="true">{"✓"}</span><span class="sr-only">Included</span></> : <><span class="x-n" aria-hidden="true">{"–"}</span><span class="sr-only">Not included</span></>}</td>
            ))}
          </tr>
        ))}
      </>))}
    </tbody>
  </table></div></div>
  <p class="pnote">{WORDS.note}</p>
</div></section>
