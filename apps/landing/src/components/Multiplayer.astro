---
// "Every artifact is multiplayer": two signed-in viewers of one artifact. A
// tiny in-page bus stands in for the artifact's Durable Object, and each window
// writes with update() and repaints from subscribe(), like a real live page.
const slug = "Tq7mW4";
const todos = [
  { id: "venue", t: "Book the venue", done: true, by: "Ana" },
  { id: "agenda", t: "Send the agenda", done: true, by: "Sam" },
  { id: "lunch", t: "Order lunch", done: false, by: "Ana" },
  { id: "badges", t: "Print name badges", done: false, by: "Sam" },
  { id: "travel", t: "Share travel details", done: false, by: "Ana" },
];
const done = todos.filter((t) => t.done).length;
// The page's code, highlighted by hand: k keyword, f call, s string, c comment.
const code = `<span class="k">await</span> openArtifacts.ready;
<span class="k">const</span> me = <span class="k">await</span> openArtifacts.viewer.<span class="f">get</span>();
<span class="k">const</span> todos = openArtifacts.db.<span class="f">collection</span>(<span class="s">"todos"</span>);

<span class="c">// Every open window hears every change.</span>
todos.<span class="f">subscribe</span>(({ docs }) =&gt; <span class="f">render</span>(docs));

<span class="c">// Sam checks a box. Ana's window updates.</span>
<span class="k">await</span> todos.<span class="f">update</span>(id, { done: <span class="k">true</span>, by: me.name });`;
---

<div class="mp" data-mp>
  <div class="mp-wins">
    {
      ["Ana", "Sam"].map((who) => (
        <figure class="mp-win" data-who={who}>
          <div class="mp-bar">
            <svg class="mp-lock" viewBox="0 0 16 16" width="13" height="13" aria-hidden="true">
              <rect x="3" y="7" width="10" height="7" rx="1.5" fill="currentColor" />
              <path d="M5.5 7V5a2.5 2.5 0 0 1 5 0v2" fill="none" stroke="currentColor" stroke-width="1.5" />
            </svg>
            <span class="mp-url mono">
              artifacts.example.com/a/<b>{slug}</b>
            </span>
            <span class="mp-me">
              <span class="mp-av" aria-hidden="true">{who[0]}</span>
              <span class="sr-only">Logged in as </span>
              {who}
            </span>
          </div>
          <div class="mp-art">
            <p class="mp-h">
              <b>Offsite prep</b> <span data-n>{done} of {todos.length} done</span>
            </p>
            <ul aria-label={`Offsite prep, in ${who}'s window`}>
              {todos.map((t) => (
                <li data-id={t.id}>
                  <label>
                    <input type="checkbox" checked={t.done} /> {t.t}
                  </label>
                  <span class="mp-by" data-by>
                    updated by {t.by}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        </figure>
      ))
    }
  </div>
  <p class="sr-only" role="status" aria-live="polite" data-mp-note></p>
  <div class="mp-foot">
    <p class="mp-why">
      Each artifact gets its own Durable Object, with its own SQLite store, on your Cloudflare account.
      Writes reach every open window over WebSockets, and access follows the artifact's sharing.
    </p>
    <pre class="mp-code" aria-label="The page's code, using window.openArtifacts"><code set:html={code} /></pre>
  </div>
</div>

<style>
  .mp {
    --mp-k: #8a3fb8;
    --mp-s: #1d7a46;
    --mp-c: #6b7280;
    --mp-f: #2350d0;
    margin-top: 24px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) .mp {
      --mp-k: #d19bf2;
      --mp-s: #7fd49e;
      --mp-c: #8b939e;
      --mp-f: #9db3ff;
    }
  }
  :root[data-theme="dark"] .mp {
    --mp-k: #d19bf2;
    --mp-s: #7fd49e;
    --mp-c: #8b939e;
    --mp-f: #9db3ff;
  }
  .mp-wins {
    display: grid;
    gap: 16px;
  }
  @media (min-width: 760px) {
    .mp-wins {
      grid-template-columns: 1fr 1fr;
      gap: 24px;
    }
  }
  .mp-win {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border-radius: var(--oa-radius-lg);
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-2);
  }
  .mp-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 10px 0 14px;
    border-bottom: 1px solid var(--oa-divider);
    background: var(--oa-chrome);
  }
  .mp-lock {
    flex: none;
    color: var(--oa-text-muted);
  }
  .mp-url {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    color: var(--oa-text-2);
    font-size: var(--oa-text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .mp-url b {
    color: var(--oa-text);
    font-weight: 500;
  }
  .mp-me {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: 6px;
    padding: 2px 8px 2px 2px;
    border-radius: 999px;
    background: var(--oa-surface);
    box-shadow: 0 0 0 1px var(--oa-divider);
    font-size: var(--oa-text-sm);
    font-weight: 500;
  }
  .mp-av {
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--oa-accent-soft);
    color: var(--oa-accent-fg);
    font-size: var(--oa-text-xs);
  }
  [data-who="Sam"] .mp-av {
    background: var(--oa-text);
    color: var(--oa-surface);
  }
  .mp-art {
    padding: 16px 18px 12px;
  }
  .mp-h {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    color: var(--oa-text-muted);
    font-size: var(--oa-text-sm);
  }
  .mp-h b {
    color: var(--oa-text);
    font-size: var(--oa-text-lg);
    font-weight: 600;
  }
  .mp ul {
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }
  .mp li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin: 0 -8px;
    padding: 0 8px;
    border-radius: var(--oa-radius-md);
  }
  .mp li + li {
    box-shadow: 0 -1px 0 var(--oa-divider);
  }
  .mp label {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 10px;
    min-width: 0;
    min-height: 40px;
    cursor: pointer;
  }
  .mp input {
    flex: none;
    width: 16px;
    height: 16px;
    margin: 0;
    accent-color: var(--oa-success);
  }
  .mp label:has(:checked) {
    color: var(--oa-text-muted);
    text-decoration: line-through;
  }
  .mp-by {
    flex: none;
    color: var(--oa-text-muted);
    font-size: var(--oa-text-xs);
  }
  /* The other window's row, just after a write arrives. */
  .mp li.flash {
    animation: mp-flash 1.6s var(--oa-ease);
  }
  .mp li.flash .mp-by {
    color: var(--oa-accent-fg);
  }
  @keyframes mp-flash {
    0%,
    30% {
      background: var(--oa-accent-soft);
    }
  }
  .mp-foot {
    display: grid;
    gap: 16px;
    margin-top: 24px;
  }
  @media (min-width: 900px) {
    .mp-foot {
      grid-template-columns: 4fr 6fr;
      align-items: start;
      gap: 32px;
    }
  }
  .mp-why {
    max-width: 52ch;
    color: var(--oa-text-2);
    font-size: 15px;
  }
  .mp-code {
    min-width: 0;
    margin: 0;
    padding: 14px 16px;
    overflow-x: auto;
    border-radius: var(--oa-radius-md);
    background: var(--oa-surface);
    box-shadow: var(--oa-shadow-1);
    font: 12.5px / 1.6 var(--oa-font-mono);
  }
  .mp-code :global(.k) {
    color: var(--mp-k);
  }
  .mp-code :global(.s) {
    color: var(--mp-s);
  }
  .mp-code :global(.c) {
    color: var(--mp-c);
    font-style: italic;
  }
  .mp-code :global(.f) {
    color: var(--mp-f);
  }
  @media (max-width: 420px) {
    .mp-art {
      padding: 12px 14px 8px;
    }
    .mp-url {
      font-size: 11.5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mp li.flash {
      animation: none;
    }
  }
</style>

<script>
  const mp = document.querySelector<HTMLElement>("[data-mp]");
  if (mp) {
    type Doc = { id: string; data: { done: boolean; by: string } };
    type Change = { docs: Doc[]; deleted: string[] };
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const note = mp.querySelector<HTMLElement>("[data-mp-note]");
    const wins = [...mp.querySelectorAll<HTMLElement>("[data-who]")];
    // Stands in for the artifact's Durable Object: every write goes to every subscriber.
    const subs = new Set<(e: Change) => void>();
    const collection = () => ({
      async update(id: string, patch: Doc["data"]) {
        for (const cb of subs) cb({ docs: [{ id, data: patch }], deleted: [] });
      },
      subscribe(cb: (e: Change) => void) {
        subs.add(cb);
        return () => subs.delete(cb);
      },
    });
    const row = (win: HTMLElement, id: string) => win.querySelector<HTMLElement>(`[data-id="${id}"]`);
    // A gentle demo while the section is on screen: Sam, then Ana, each check one item.
    const demo: [number, string][] = [
      [1, "lunch"],
      [0, "badges"],
    ];
    let step = 0;
    let timer = 0;

    for (const win of wins) {
      const me = win.dataset.who ?? "";
      const todos = collection();
      const boxes = [...win.querySelectorAll<HTMLInputElement>("input")];
      todos.subscribe(({ docs }) => {
        for (const { id, data } of docs) {
          const li = row(win, id);
          const box = li?.querySelector("input");
          const by = li?.querySelector("[data-by]");
          if (!li || !box || !by) continue;
          box.checked = data.done;
          by.textContent = `updated by ${data.by}`;
          if (data.by !== me && !reduce.matches) {
            li.classList.remove("flash");
            void li.offsetWidth;
            li.classList.add("flash");
          }
        }
        const n = win.querySelector("[data-n]");
        if (n) n.textContent = `${boxes.filter((b) => b.checked).length} of ${boxes.length} done`;
      });
      win.addEventListener("change", (e) => {
        const box = e.target as HTMLInputElement;
        const id = box.closest("li")?.dataset.id ?? "";
        todos.update(id, { done: box.checked, by: me });
        if (!e.isTrusted) return;
        // The visitor took over: no more demo, and say what the other window got.
        step = demo.length;
        clearTimeout(timer);
        const other = me === "Ana" ? "Sam" : "Ana";
        const label = box.parentElement?.textContent?.trim();
        if (note)
          note.textContent = `${other}'s window updated: ${me} ${box.checked ? "checked" : "unchecked"} ${label}.`;
      });
    }

    const next = () => {
      const s = demo[step++];
      const box = s && row(wins[s[0]], s[1])?.querySelector("input");
      if (!box) return;
      box.checked = !box.checked;
      box.dispatchEvent(new Event("change", { bubbles: true }));
      if (step < demo.length) timer = window.setTimeout(next, 2400);
    };
    new IntersectionObserver(([e]) => {
      clearTimeout(timer);
      if (e.isIntersecting && step < demo.length && !reduce.matches) timer = window.setTimeout(next, 1200);
    }, { threshold: 0.4 }).observe(wins[0].parentElement ?? mp);
  }
</script>
