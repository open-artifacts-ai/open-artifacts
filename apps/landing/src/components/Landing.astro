---
// The landing page body, shared by the index and /v1/ (Product demo).
import { REPO_URL } from "@oa/shared";
import { heroActions } from "../lib/hero";
import AgentWiring from "./AgentWiring.astro";
import ChatDemo from "./ChatDemo.astro";
import FeatureStory from "./FeatureStory.astro";
import Gallery from "./gallery/Gallery.astro";
import Multiplayer from "./Multiplayer.astro";
import Shot from "./Shot.astro";

const prompt = "install open-artifacts.com/llms.txt";
// The chip keeps the URL on one line when the phrase wraps.
const [promptLead, promptUrl] = prompt.split(/(?<=install )/);
const actions = heroActions(import.meta.env.HOSTED_SIGNUP_URL);

const features = [
  {
    title: "HTML, Markdown, code and PDF",
    body: "Interactive pages, rendered docs, highlighted code and PDFs, viewed in a web dashboard with search.",
  },
  {
    title: "Every version kept",
    body: "Each publish is a new version that records which agent made it. View or restore any of them.",
  },
  {
    title: "Private until you share",
    body: "Share with people by email as viewer or editor, or make a public link that search engines don't index.",
  },
  {
    title: "Live pages",
    body: "An HTML artifact can save and read shared data, so polls, trackers and checklists just work.",
  },
  {
    title: "Any AI agent",
    body: "Claude Code, Codex CLI, Cursor, OpenCode, ChatGPT, or anything else that speaks MCP.",
  },
  {
    title: "Yours to run",
    body: "MIT-licensed. Run it yourself, in your own Cloudflare account.",
  },
];

const plans = [
  {
    name: "Workers Free",
    who: "For you",
    price: "$0",
    body: "Publish, version and share everything your agents make. Sized for one person.",
  },
  {
    name: "Workers Paid",
    who: "For your team",
    price: "$5 a month",
    body: "Invite emails for teammates, and more CPU for large publishes. Sized for a team.",
  },
];
---
  <section class="hero wrap">
    <h1>
      <span>Bring any agent.</span>
      <span>Keep every artifact.</span>
    </h1>
    <p class="lede">
      Open Artifacts is an <a href={REPO_URL}>open source</a> home for the pages, docs, code and
      PDFs that any AI agent makes. Share them with your team, keep every version, and build live
      pages people use together.
    </p>

    <div class="hero-actions">
      {actions.map((a) => (
        <a class:list={["btn", "lg", { primary: a.primary }]} href={a.href}>{a.label}</a>
      ))}
    </div>

    <div class="cta" role="group" aria-labelledby="cta-label">
      <p id="cta-label" class="cta-label">
        Self-hosting runs in your own Cloudflare account. Tell your agent:
      </p>
      <div class="cta-row">
        <code class="cta-prompt">{prompt}</code>
        <button class="btn primary" type="button" data-copy={prompt} hidden>
          <span data-idle>Copy</span>
          <span data-done hidden>Copied</span>
        </button>
      </div>
      <p class="cta-note" role="status" aria-live="polite"></p>
    </div>

    <AgentWiring />

    <figure class="frame hero-shot">
      <Shot
        name="library"
        eager
        sizes="(min-width: 1180px) 1120px, 100vw"
        alt="The Open Artifacts library: a grid of artifacts with thumbnails, the agent that made each one, and its visibility."
      />
    </figure>
  </section>

  <section class="wrap demo-section" aria-labelledby="demo-h">
    <h2 id="demo-h">Ask in chat. Get a link.</h2>
    <p class="section-lede">
      Ask any AI agent to publish. It calls publish_artifact and hands you a private link to the real
      thing, ready to click and use. Try each example.
    </p>
    <ChatDemo />
  </section>

  <section class="wrap gallery-section" aria-labelledby="gallery-h">
    <h2 id="gallery-h">What any AI agent makes</h2>
    <p class="section-lede">
      Six artifacts that agents published, and every one works. Use them here, or open one to see its
      link, its versions and who it's shared with.
    </p>
    <Gallery />
  </section>

  <section class="wrap multi-section" aria-labelledby="multi-h">
    <h2 id="multi-h">Every live page is multiplayer</h2>
    <p class="section-lede">
      Everyone who opens a live page works on the same data. When Sam checks an item, Ana's window
      shows it right away, with Sam's name on it. Try it in either window.
    </p>
    <Multiplayer />
  </section>

  <section class="band" id="self-host" aria-labelledby="steps-h">
    <div class="wrap">
      <h2 id="steps-h">Self-host in three steps</h2>
      <ol class="steps">
        <li>
          <h3>Tell your agent</h3>
          <p>
            Your agent reads llms.txt, checks the prerequisites, clones the latest release, and runs
            pnpm install.
          </p>
          <span class="step-chip mono" aria-hidden="true"
            ><span class="caret">{"\u203a"}</span><span>{promptLead}<span class="nowrap">{promptUrl}</span></span></span
          >
        </li>
        <li>
          <h3>Sign in to Cloudflare</h3>
          <p>
            One step needs you: <code>npx wrangler login</code>. Setup then creates D1, R2 and KV and the
            Access sign-in app, deploys to both domains, and adds the MCP server to your agent.
          </p>
          <span class="step-chip" aria-hidden="true">
            Allow Wrangler to manage your account? <span class="mini-btn">Allow</span>
          </span>
        </li>
        <li>
          <h3>Publish and share</h3>
          <p>
            Your agent publishes a Welcome artifact and gives you the link. Later, ask it to write up the
            Q4 data migration plan and share it with a teammate.
          </p>
          <span class="step-chip" aria-hidden="true">
            <span class="mono">artifacts.example.com/a/7Hq3…</span>
            <span class="badge team">Team</span>
          </span>
        </li>
      </ol>
    </div>
  </section>

  <section class="wrap story-section" aria-labelledby="story-h">
    <h2 id="story-h">One library for everything your agents publish</h2>
    <p class="section-lede">Versions, sharing and access control, in one dashboard.</p>
    <FeatureStory />
  </section>

  <section class="wrap features" aria-labelledby="features-h">
    <h2 id="features-h">What you get</h2>
    <ul class="cards">
      {
        features.map((f) => (
          <li class="card">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap features plans" aria-labelledby="plans-h">
    <h2 id="plans-h">Which Cloudflare plan</h2>
    <p class="section-lede">Open Artifacts runs on either. Pick the one that fits who uses it.</p>
    <ul class="cards">
      {
        plans.map((p) => (
          <li class="card">
            <p class="plan-who">{p.who}</p>
            <h3>{p.name}</h3>
            <p class="plan-price">{p.price}</p>
            <p>{p.body}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap pair" aria-label="Screens">
    <figure class="frame">
      <Shot
        name="artifact"
        sizes="(min-width: 900px) 550px, 100vw"
        alt="An artifact open in the viewer, with its version history in the side panel."
      />
      <figcaption>Every publish is a version you can view or restore.</figcaption>
    </figure>
    <figure class="frame">
      <Shot
        name="share"
        sizes="(min-width: 900px) 550px, 100vw"
        alt="The share dialog: private, team, or public visibility, and people invited as viewers or editors."
      />
      <figcaption>Share with people by email, with your team, or by public link.</figcaption>
    </figure>
  </section>

  <section class="band" aria-labelledby="security-h">
    <div class="wrap security">
      <div>
        <h2 id="security-h">Safe to open</h2>
        <p class="lede">
          Agent-written HTML runs in a sandboxed frame on a separate, cookieless origin. It can't read
          your session, call the API as you, or reach the dashboard.
        </p>
      </div>
      <dl>
        <div>
          <dt>Sandboxed</dt>
          <dd>
            Each artifact runs in its own opaque origin, so it can't see the dashboard or other
            artifacts.
          </dd>
        </div>
        <div>
          <dt>No passwords</dt>
          <dd>Sign-in goes through Cloudflare Access with a one-time PIN, GitHub, or Google.</dd>
        </div>
        <div>
          <dt>Private by default</dt>
          <dd>
            New artifacts are visible only to their creator. Anything you can't see returns a 404, so
            a link never reveals that it exists.
          </dd>
        </div>
        <div>
          <dt>Never indexed</dt>
          <dd>Public links send noindex headers, and robots.txt blocks crawlers on both hosts.</dd>
        </div>
        <div>
          <dt>Revocable tokens</dt>
          <dd>Agent tokens are stored only as hashes, and you can revoke them in settings.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="wrap source" aria-labelledby="source-h">
    <h2 id="source-h">Open source, MIT licensed</h2>
    <p>Read the code, file an issue, or run it yourself.</p>
    <a class="btn" href={REPO_URL}>View on GitHub</a>
  </section>


<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
    const idle = button.querySelector<HTMLElement>("[data-idle]");
    const done = button.querySelector<HTMLElement>("[data-done]");
    const note = button.closest(".cta")?.querySelector<HTMLElement>(".cta-note");
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? "");
        if (idle && done) {
          idle.hidden = true;
          done.hidden = false;
        }
        if (note) note.textContent = "Copied. Paste it into your agent.";
        setTimeout(() => {
          if (idle && done) {
            idle.hidden = false;
            done.hidden = true;
          }
        }, 2000);
      } catch {
        if (note) note.textContent = "Copy failed. Select the text and copy it yourself.";
      }
    });
  }
</script>
