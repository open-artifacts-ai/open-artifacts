{
  // Committed staging config. The gitignored wrangler.jsonc is setup-generated.
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "env": {
    "staging": {
      "name": "open-artifacts-staging",
      // The Worker answers APP_HOST and CONTENT_HOST only (any other host is
      // a plain 404), but the workers.dev URL must still never be live.
      "workers_dev": false,
      "preview_urls": false,
      "compatibility_flags": ["nodejs_compat"],
      "routes": [
        { "pattern": "staging.open-artifacts.com", "custom_domain": true },
        {
          "pattern": "staging-content.open-artifacts.com",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "open-artifacts-staging",
          "database_id": "5155e2d4-d9bf-4900-b4ab-1febd480377a",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        { "binding": "FILES", "bucket_name": "open-artifacts-staging" }
      ],
      "kv_namespaces": [
        { "binding": "OAUTH_KV", "id": "886a49c875024e8ab5262928d75f85b7" }
      ],
      "durable_objects": {
        "bindings": [
          { "name": "ARTIFACT_RUNTIME", "class_name": "ArtifactRuntime" },
          // P3 T7b (#503): bound with its first use, one release after its v2 tag.
          { "name": "USER_PRESENCE", "class_name": "UserPresence" }
        ]
      },
      "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["ArtifactRuntime"] },
        // P3 T7a (#502): the class ships unbound one release before T7b binds and uses it.
        { "tag": "v2", "new_sqlite_classes": ["UserPresence"] },
        // P3 T13a (#571): the class ships unbound one release before #575 binds and uses it.
        { "tag": "v3", "new_sqlite_classes": ["DirectorySync"] }
      ],
      // Browser Run (server-side thumbnails). Workers edit suffices to deploy.
      "browser": { "binding": "BROWSER" },
      // Email Sending (team invites) from the onboarded mail.open-artifacts.com;
      // EMAIL_FROM below must stay on that domain.
      "send_email": [{ "name": "EMAIL" }],
      "assets": {
        "binding": "ASSETS",
        "directory": "./dist-assets",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "ratelimits": [
        {
          "name": "RL_ANON",
          "namespace_id": "1001",
          "simple": { "limit": 30, "period": 60 }
        },
        {
          "name": "RL_AUTH",
          "namespace_id": "1002",
          "simple": { "limit": 20, "period": 60 }
        }
      ],
      "triggers": { "crons": ["17 3 * * *"] },
      // Workers Logs: keep every request (email_sent / email_failed lines).
      "observability": { "enabled": true, "head_sampling_rate": 1 },
      // Secrets are NOT configured here. Deploys overwrite vars, so
      // ACCESS_CLIENT_ID lives here. It is a public OIDC client id (not a
      // secret), set by the ops-staging-access workflow on 2026-10-18.
      "vars": {
        "ENVIRONMENT": "production",
        "APP_HOST": "staging.open-artifacts.com",
        "CONTENT_HOST": "staging-content.open-artifacts.com",
        "OWNER_EMAIL": "me@leourbina.com",
        "EMAIL_FROM": "noreply@mail.open-artifacts.com",
        // Staging is Workers Paid: server-side thumbnails on (BROWSER above).
        "SERVER_THUMBNAILS": "on",
        // Staging runs on Workers Paid: Paid data-doc and /mcp body limits.
        "PLAN": "paid",
        "ACCESS_TEAM_DOMAIN": "leourbina.cloudflareaccess.com",
        "CF_ACCOUNT_ID": "26ac346086d4405f7a976d48747a2a75",
        "WORKER_NAME": "open-artifacts-staging",
        "OAUTH_KV_ID": "886a49c875024e8ab5262928d75f85b7",
        "ACCESS_CLIENT_ID": "e332570b66c35883120a21ccfe376f6394aa4089c08cb73c6224b96fab1da7e2"
      }
    }
  }
}
