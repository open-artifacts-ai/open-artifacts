{
  "name": "oa-server-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oa-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "oa-blobs-test" }],
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "oa-kv-test" }],
  "durable_objects": {
    "bindings": [
      { "name": "ARTIFACT_RUNTIME", "class_name": "ArtifactRuntime" },
      { "name": "USER_PRESENCE", "class_name": "UserPresence" },
      { "name": "DIRECTORY_SYNC", "class_name": "DirectorySync" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ArtifactRuntime"] },
    { "tag": "v2", "new_sqlite_classes": ["UserPresence"] },
    { "tag": "v3", "new_sqlite_classes": ["DirectorySync"] }
  ],
  "ratelimits": [
    {
      "name": "RL_ANON",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RL_AUTH",
      "namespace_id": "1002",
      "simple": { "limit": 20, "period": 60 }
    },
    {
      "name": "RL_DIRECTORY",
      "namespace_id": "1003",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "vars": {
    "APP_HOST": "app.localhost",
    "CONTENT_HOST": "content.localhost",
    "ENVIRONMENT": "dev",
    "OWNER_EMAIL": "owner@example.com",
    "ACCESS_TEAM_DOMAIN": "test.cloudflareaccess.com",
    "ACCESS_CLIENT_ID": "test-client-id",
    "ACCESS_CLIENT_SECRET": "test-client-secret",
    "SESSION_SECRET": "test-session-secret-0123456789abcdef",
    "CONTENT_SIGNING_KEY": "test-content-signing-key-0123456789",
    "CF_ACCOUNT_ID": "test-account"
  }
}
