// Hosted dispatch Worker (P1 Task 6): maps the request host to an install id
// (HOSTS KV, written by provisioning) and forwards the request unchanged to
// that install's user Worker in the env's dispatch namespace.
//
// Deploy with --env staging or --env prod only (docs/ops/hosted.md): the top
// level has no name and no main, so a deploy without --env is refused,
// even with --name. No routes, custom
// domains or workers.dev here: the wildcard routes are wired once per env by
// the gated ops step, never from this file. Each env's HOSTS id has its own
// placeholder, filled at deploy (the id of oa-s-hosts / oa-p-hosts).
// Observability stays off: Workers Logs would record full URLs.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "oa-s-dispatch",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "OA_ENV": "staging" },
      "observability": { "enabled": false },
      "dispatch_namespaces": [
        { "binding": "DISPATCHER", "namespace": "oa-staging" }
      ],
      "kv_namespaces": [{ "binding": "HOSTS", "id": "{{HOSTS_KV_ID_STAGING}}" }]
    },
    "prod": {
      "name": "oa-p-dispatch",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "vars": { "OA_ENV": "prod" },
      "observability": { "enabled": false },
      "dispatch_namespaces": [
        { "binding": "DISPATCHER", "namespace": "oa-prod" }
      ],
      "kv_namespaces": [{ "binding": "HOSTS", "id": "{{HOSTS_KV_ID_PROD}}" }]
    }
  }
}
