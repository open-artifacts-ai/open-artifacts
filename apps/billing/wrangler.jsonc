// Hosted billing Worker (self-serve step 1): the tier store. One Worker per
// env, oa-s-billing / oa-p-billing, with its own D1 (oa-s-billing /
// oa-p-billing), separate from the platform D1, so a billing bug can't touch
// it. It reads the sign-in registry (BROKER_REGISTRY, the auth broker's
// namespace) and never writes it.
//
// Installs reach it only through BillingGate stubs (@oa/broker-core's
// billing-gate) that dispatch and the scheduler pass in ctx.props; the
// scheduler also calls /health over its own BILLING binding. The one public
// path, billing.<app domain>/stripe/webhook, is an exact zone route that
// scripts/ops/hosted-zones.sh manages with auth. and directory., never from
// this file. STRIPE_WEBHOOK_SECRET is a Worker secret, never a var here.
//
// Deploy with --env staging or --env prod only (scripts/ops/
// deploy-platform-worker.sh billing <env>): the top level has no name and no
// main, so a deploy without --env is refused, even with --name. No routes,
// custom domains or workers.dev here. Each env's BILLING_DB id has its own
// placeholder, filled at deploy. Observability stays off: Workers Logs would
// record full URLs; the Worker logs fixed categories and install ids only.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "oa-s-billing",
      "main": "src/index.ts",
      // OA_ENV picks the app domain the gate's app host must be on; the
      // price ids are this env's Stripe test-mode prices (filled at deploy).
      // STRIPE_SECRET_KEY is a Worker secret, never in this file.
      "vars": {
        "OA_ENV": "staging",
        "STRIPE_PRICE_TEAM": "{{STRIPE_PRICE_TEAM_STAGING}}",
        "STRIPE_PRICE_BUSINESS": "{{STRIPE_PRICE_BUSINESS_STAGING}}"
      },
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": false },
      "d1_databases": [
        {
          "binding": "BILLING_DB",
          "database_name": "oa-s-billing",
          "database_id": "{{BILLING_DB_ID_STAGING}}"
        }
      ],
      // The install registry the auth broker reads (read-only here), for the
      // POSTs' install signatures.
      "kv_namespaces": [
        {
          "binding": "BROKER_REGISTRY",
          "id": "{{BROKER_REGISTRY_ID_STAGING}}"
        }
      ]
    },
    "prod": {
      "name": "oa-p-billing",
      "main": "src/index.ts",
      // OA_ENV picks the app domain the gate's app host must be on; the
      // price ids are this env's Stripe test-mode prices (filled at deploy).
      // STRIPE_SECRET_KEY is a Worker secret, never in this file.
      "vars": {
        "OA_ENV": "prod",
        "STRIPE_PRICE_TEAM": "{{STRIPE_PRICE_TEAM_PROD}}",
        "STRIPE_PRICE_BUSINESS": "{{STRIPE_PRICE_BUSINESS_PROD}}"
      },
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": false },
      "d1_databases": [
        {
          "binding": "BILLING_DB",
          "database_name": "oa-p-billing",
          "database_id": "{{BILLING_DB_ID_PROD}}"
        }
      ],
      "kv_namespaces": [
        { "binding": "BROKER_REGISTRY", "id": "{{BROKER_REGISTRY_ID_PROD}}" }
      ]
    }
  }
}
