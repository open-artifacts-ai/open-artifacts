{
  "name": "oa-directory-broker-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "kv_namespaces": [
    { "binding": "DIRECTORY_REGISTRY", "id": "directory-test" }
  ],
  "ratelimits": [
    {
      "name": "RL_DIRECTORY_IP",
      "namespace_id": "1001",
      "simple": { "limit": 1000, "period": 60 }
    },
    {
      "name": "RL_DIRECTORY_INSTALL",
      "namespace_id": "1002",
      "simple": { "limit": 1000, "period": 60 }
    }
  ],
  "vars": {
    "GOOGLE_DIRECTORY_CLIENT_ID": "dir-cid.apps.googleusercontent.com",
    "GOOGLE_DIRECTORY_CLIENT_SECRET": "directory-google-secret",
    "DIRECTORY_ORIGIN": "https://directory.hosted.test",
    "DIRECTORY_STATE_KEY": "directory-state-key-0123456789abcdef0"
  }
}
