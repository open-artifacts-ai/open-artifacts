// Tests call the Worker with fake bindings built per case (test/fakes.ts);
// this config gives the pool a script to load, a local PLATFORM_DB (the
// platform-db migrations, applied by test/db.ts) and a local OAUTH_KV.
{
  "name": "oa-provisioning-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "oa-platform-test",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // The OAuth library's store (test/oauth-*.test.ts).
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "oauth-test" }]
}
