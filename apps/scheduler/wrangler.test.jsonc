// Tests call the handlers with a fake DISPATCHER and a local PLATFORM_DB
// (the platform-db migrations, applied by the test).
{
  "name": "oa-scheduler-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "oa-platform-test",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ]
}
