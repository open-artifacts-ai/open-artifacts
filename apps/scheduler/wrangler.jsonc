// Hosted nightly scheduler (P1 Task 7): user Workers in a dispatch namespace
// get no cron triggers, so this Worker's nightly cron calls scheduled() on
// every active install's script (platform D1 `installs`), 6 at a time, 25 s
// each. Its second cron, every 2 minutes (H-DV), calls a deleting install's
// directory-disconnect job so delete can revoke the Google grant first.
//
// Deploy with --env staging or --env prod only (docs/ops/hosted.md): the top
// level has no name and no main, so a deploy without --env is refused, even
// with --name. No routes, custom domains or workers.dev: the Worker has no
// fetch handler. Each env's
// PLATFORM_DB id has its own placeholder, filled at deploy (the id of
// oa-s-platform / oa-p-platform). Observability is on: no request URLs, and
// the logs carry install ids, fixed categories and counts only.
// The email-quota alert (src/quota.ts) reads Email Sending analytics: its
// zone tags and the account's daily limit are per-env vars with placeholders
// filled at deploy; its token is the secret EMAIL_QUOTA_TOKEN (wrangler secret
// put, never a var).
// Provisioning API duties (src/provapi, design v7 5.8) on the */2 tick: the
// job sweep and purge after grace start the provisioner's Workflows
// (PROVISION_INSTALL, MANAGE_INSTALL, script oa-<p>-provisioner, which must
// deploy first), the alerts read PROVISIONER's ProvisionerRpc and email
// through the send_email binding ALERT_EMAIL; the signups duty re-sends
// waiting_cap and lost pending signups on oa-<p>-signups (SIGNUPS, which
// must exist first). ALERT_TO, ALERT_FROM, SIGNUP_DAILY_CAP and
// SIGNUPS_ENABLED are per-env placeholders that deploy-platform-worker.sh
// fills (ALERT_TO is also ALERT_EMAIL's only destination_address); it
// refuses a config without all of them.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "staging": {
      "name": "oa-s-scheduler",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "OA_ENV": "staging",
        "EMAIL_QUOTA_ZONES": "{{EMAIL_ZONE_TAG_STAGING}}",
        "EMAIL_DAILY_LIMIT": "{{EMAIL_DAILY_LIMIT_STAGING}}",
        "ALERT_TO": "{{ALERT_TO_STAGING}}",
        "ALERT_FROM": "{{ALERT_FROM_STAGING}}",
        "SIGNUP_DAILY_CAP": "{{SIGNUP_DAILY_CAP_STAGING}}",
        "SIGNUPS_ENABLED": "{{SIGNUPS_ENABLED_STAGING}}",
        "AUTH_BROKER_ORIGIN": "https://auth.open-artifacts-staging.app",
        "DIRECTORY_BROKER_ORIGIN": "https://directory.open-artifacts-staging.app"
      },
      // The BrokerGate stubs each install call carries (see the gate), and
      // the provisioner's RPC entrypoint (tokenStatus for the token alerts).
      "services": [
        { "binding": "AUTH_BROKER", "service": "oa-s-auth-broker" },
        { "binding": "DIRECTORY_BROKER", "service": "oa-s-directory-broker" },
        {
          "binding": "PROVISIONER",
          "service": "oa-s-provisioner",
          "entrypoint": "ProvisionerRpc"
        }
      ],
      "workflows": [
        {
          "name": "oa-s-provision-install",
          "binding": "PROVISION_INSTALL",
          "class_name": "ProvisionInstall",
          "script_name": "oa-s-provisioner"
        },
        {
          "name": "oa-s-manage-install",
          "binding": "MANAGE_INSTALL",
          "class_name": "ManageInstall",
          "script_name": "oa-s-provisioner"
        }
      ],
      // The signups duty's producer (src/provapi/signups.ts): { signupId }
      // only; the provisioner consumes it.
      "queues": {
        "producers": [{ "binding": "SIGNUPS", "queue": "oa-s-signups" }]
      },
      "send_email": [
        { "name": "ALERT_EMAIL", "destination_address": "{{ALERT_TO_STAGING}}" }
      ],
      "observability": { "enabled": true },
      "triggers": { "crons": ["17 3 * * *", "*/2 * * * *"] },
      "dispatch_namespaces": [
        { "binding": "DISPATCHER", "namespace": "oa-staging" }
      ],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-s-platform",
          "database_id": "{{PLATFORM_DB_ID_STAGING}}"
        }
      ]
    },
    "prod": {
      "name": "oa-p-scheduler",
      "main": "src/index.ts",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "OA_ENV": "prod",
        "EMAIL_QUOTA_ZONES": "{{EMAIL_ZONE_TAG_PROD}}",
        "EMAIL_DAILY_LIMIT": "{{EMAIL_DAILY_LIMIT_PROD}}",
        "ALERT_TO": "{{ALERT_TO_PROD}}",
        "ALERT_FROM": "{{ALERT_FROM_PROD}}",
        "SIGNUP_DAILY_CAP": "{{SIGNUP_DAILY_CAP_PROD}}",
        "SIGNUPS_ENABLED": "{{SIGNUPS_ENABLED_PROD}}",
        "AUTH_BROKER_ORIGIN": "https://auth.open-artifacts.app",
        "DIRECTORY_BROKER_ORIGIN": "https://directory.open-artifacts.app"
      },
      // The BrokerGate stubs each install call carries (see the gate), and
      // the provisioner's RPC entrypoint (tokenStatus for the token alerts).
      "services": [
        { "binding": "AUTH_BROKER", "service": "oa-p-auth-broker" },
        { "binding": "DIRECTORY_BROKER", "service": "oa-p-directory-broker" },
        {
          "binding": "PROVISIONER",
          "service": "oa-p-provisioner",
          "entrypoint": "ProvisionerRpc"
        }
      ],
      "workflows": [
        {
          "name": "oa-p-provision-install",
          "binding": "PROVISION_INSTALL",
          "class_name": "ProvisionInstall",
          "script_name": "oa-p-provisioner"
        },
        {
          "name": "oa-p-manage-install",
          "binding": "MANAGE_INSTALL",
          "class_name": "ManageInstall",
          "script_name": "oa-p-provisioner"
        }
      ],
      // The signups duty's producer (src/provapi/signups.ts): { signupId }
      // only; the provisioner consumes it.
      "queues": {
        "producers": [{ "binding": "SIGNUPS", "queue": "oa-p-signups" }]
      },
      "send_email": [
        { "name": "ALERT_EMAIL", "destination_address": "{{ALERT_TO_PROD}}" }
      ],
      "observability": { "enabled": true },
      "triggers": { "crons": ["17 3 * * *", "*/2 * * * *"] },
      "dispatch_namespaces": [
        { "binding": "DISPATCHER", "namespace": "oa-prod" }
      ],
      "d1_databases": [
        {
          "binding": "PLATFORM_DB",
          "database_name": "oa-p-platform",
          "database_id": "{{PLATFORM_DB_ID_PROD}}"
        }
      ]
    }
  }
}
