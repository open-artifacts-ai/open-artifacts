{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@oa/provision/versions": ["../../packages/provision/src/versions.ts"],
      "@oa/shared": ["../../packages/shared/src/index.ts"],
      "@oa/shared/*": ["../../packages/shared/src/*"],
      "@oa/provisioning-contract": [
        "../../packages/provisioning-contract/src/index.ts"
      ],
      "@oa/provisioning-contract/*": [
