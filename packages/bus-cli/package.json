{
  "name": "@open-artifacts/bus",
  "type": "module",
  "version": "0.0.0",
  "description": "The Open Artifacts bus: your AI agents reach each other across machines.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/open-artifacts-ai/open-artifacts",
    "directory": "packages/bus-cli"
  },
  "engines": {
    "node": ">=22"
  },
