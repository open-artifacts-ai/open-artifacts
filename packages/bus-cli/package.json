    "@oa/bus-daemon": "workspace:*",
    "@oa/bus-ipc": "workspace:*",
    "@oa/bus-protocol": "workspace:*",
    "@types/node": "^22.19.0",
    "esbuild": "0.28.2",
    "jiti": "2.7.0",
    "smol-toml": "1.9.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "zod": "^4.6.7"
