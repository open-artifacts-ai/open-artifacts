  "devDependencies": {
    "@oa/bus-adapter-claude-code": "workspace:*",
    "@oa/bus-ipc": "workspace:*",
    "@types/node": "^22.19.0",
    "esbuild": "0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
