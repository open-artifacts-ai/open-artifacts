    "agent": "Generic",
    "code": "{
  "mcpServers": {
    "open-artifacts": {
      "type": "http",
      "url": "https://oa.example.com/mcp"
    }
  }
}",
    "language": "json",
    "reload": "Restart your AI agent, or reload its MCP servers.",
    "variant": "oauth",
    "verify": "Ask your AI agent to list the open-artifacts tools. You should see publish_artifact.",
  },
  {
    "agent": "Claude Code",
    "code": "claude mcp add-json -s user open-artifacts '{"type":"http","url":"https://oa.example.com/mcp","headersHelper":"T=$(cat ~/.open-artifacts/oa-example-com-pat-token) && printf '\\''{\\"Authorization\\":\\"Bearer %s\\"}'\\'' \\"$T\\""}'",
    "hint": "Claude Code reads the token from ~/.open-artifacts/oa-example-com-pat-token each time it connects. It's added for your user, so it works in every project.",
    "language": "bash",
    "reload": "Start a new Claude Code session, or reconnect from \`/mcp\`.",
    "variant": "token",
    "verify": "Run \`claude mcp list\`. It shows open-artifacts as connected.",
  },
  {
    "agent": "Codex CLI",
    "code": "[mcp_servers.open-artifacts]
url = "https://oa.example.com/mcp"
http_headers_helper = "T=$(cat ~/.open-artifacts/oa-example-com-pat-token) && printf '{\\"Authorization\\":\\"Bearer %s\\"}' \\"$T\\""",
    "file": "~/.codex/config.toml",
    "hint": "This needs Codex 0.163 or later. On older versions, use OAuth.",
    "language": "toml",
    "reload": "Restart Codex (the CLI, IDE extension or app). It reads its config when it starts.",
    "variant": "token",
    "verify": "Run \`codex mcp list\`. It shows open-artifacts.",
  },
