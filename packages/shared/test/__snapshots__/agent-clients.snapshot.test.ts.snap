exports[`agentClients snapshots > default output is unchanged (file form) 1`] = `
[
  {
    "agent": "Claude Code",
    "code": "claude mcp add --transport http -s user open-artifacts https://oa.example.com/mcp",
    "language": "bash",
    "reload": "Start a new Claude Code session, or reconnect from \`/mcp\`.",
    "variant": "oauth",
    "verify": "In a Claude Code session, run \`/mcp\` (or \`claude mcp login open-artifacts\`) and sign in with your browser. Then \`claude mcp list\` shows open-artifacts as connected.",
  },
