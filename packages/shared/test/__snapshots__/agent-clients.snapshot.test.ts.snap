      "url": "https://oa.example.com/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {file:~/.open-artifacts/oa-example-com-pat-token}"
      }
    }
  }
}",
    "file": "opencode.json",
    "hint": "OpenCode reads the token file even when it runs in the background. Don't run \`opencode service\` from inside an OpenCode session, because it restarts the server.",
    "language": "json",
    "reload": "Restart OpenCode. It reads its config when it starts.",
    "variant": "token",
    "verify": "Run \`opencode mcp list\`. It shows open-artifacts as connected.",
  },
  {
    "agent": "Generic",
    "code": "Use your client's option to read the token from ~/.open-artifacts/oa-example-com-pat-token when it connects. If it has none, use OAuth. Never paste the token into a config file.",
