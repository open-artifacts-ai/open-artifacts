    "verify": "Find open-artifacts under Customize in the sidebar. When Cursor asks you to sign in, finish in your browser. Cursor then lists its tools.",
  },
  {
    "agent": "OpenCode",
    "code": "{
  "mcp": {
    "open-artifacts": {
      "type": "remote",
      "url": "https://oa.example.com/mcp"
    }
  }
}",
    "file": "opencode.json",
    "language": "json",
    "reload": "Restart OpenCode. It reads its config when it starts.",
