// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`agentClients snapshots > admin snippets: oa-admin with get_world 1`] = `
[
  {
    "agent": "Claude Code",
    "code": "claude mcp add --transport http oa-admin https://api.open-artifacts.app/mcp",
    "language": "bash",
    "reload": "Start a new Claude Code session, or reconnect from \`/mcp\`.",
    "variant": "oauth",
    "verify": "In a Claude Code session, run \`/mcp\`, pick oa-admin and sign in with your browser. Claude Code then lists its tools.",
  },
  {
    "agent": "Codex CLI",
    "code": "[mcp_servers.oa-admin]
url = "https://api.open-artifacts.app/mcp"",
    "file": "~/.codex/config.toml",
    "language": "toml",
    "reload": "Restart Codex. It reads config.toml when it starts.",
    "variant": "oauth",
    "verify": "Run \`codex mcp login oa-admin\` to sign in with your browser. Then \`codex mcp list\` shows oa-admin.",
  },
  {
    "agent": "Cursor",
    "code": "{
  "mcpServers": {
    "oa-admin": {
      "url": "https://api.open-artifacts.app/mcp"
    }
  }
}",
    "file": "~/.cursor/mcp.json",
    "language": "json",
    "reload": "Turn the server off and on again in Customize, or restart Cursor.",
    "variant": "oauth",
    "verify": "Find oa-admin under Customize in the sidebar. When Cursor asks you to sign in, finish in your browser. Cursor then lists its tools.",
  },
  {
    "agent": "OpenCode",
    "code": "{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "oa-admin": {
      "type": "remote",
      "url": "https://api.open-artifacts.app/mcp",
      "enabled": true
    }
  }
}",
    "file": "opencode.json",
    "language": "json",
    "reload": "Restart OpenCode. It reads its config when it starts.",
    "variant": "oauth",
    "verify": "Run \`opencode mcp auth oa-admin\` to sign in with your browser. Then \`opencode mcp list\` shows oa-admin.",
  },
  {
    "agent": "Generic",
    "code": "{
  "mcpServers": {
    "oa-admin": {
      "type": "http",
      "url": "https://api.open-artifacts.app/mcp"
    }
  }
}",
    "language": "json",
    "reload": "Restart your AI agent, or reload its MCP servers.",
    "variant": "oauth",
    "verify": "Ask your AI agent to list the oa-admin tools. You should see get_world.",
  },
  {
    "agent": "Claude Code",
    "code": "read -rs OA_TOKEN
claude mcp add --transport http oa-admin https://api.open-artifacts.app/mcp --header "Authorization: Bearer $OA_TOKEN"
unset OA_TOKEN",
    "hint": "Paste your token when prompted. It stays hidden as you type, and Claude Code saves it in its own config.",
    "language": "bash",
    "reload": "Start a new Claude Code session, or reconnect from \`/mcp\`.",
    "variant": "token",
    "verify": "Run \`claude mcp list\`. It shows oa-admin as connected.",
  },
  {
    "agent": "Codex CLI",
    "code": "[mcp_servers.oa-admin]
url = "https://api.open-artifacts.app/mcp"
bearer_token_env_var = "OA_TOKEN"",
    "file": "~/.codex/config.toml",
    "hint": "Export OA_TOKEN in the shell that starts Codex.",
    "language": "toml",
    "reload": "Restart Codex. It reads config.toml when it starts.",
    "variant": "token",
    "verify": "Run \`codex mcp list\`. It shows oa-admin.",
  },
  {
    "agent": "Cursor",
    "code": "{
  "mcpServers": {
    "oa-admin": {
      "url": "https://api.open-artifacts.app/mcp",
      "headers": {
        "Authorization": "Bearer \${env:OA_TOKEN}"
      }
    }
  }
}",
    "file": "~/.cursor/mcp.json",
    "hint": "Export OA_TOKEN before you open Cursor.",
    "language": "json",
    "reload": "Turn the server off and on again in Customize, or restart Cursor.",
    "variant": "token",
    "verify": "Customize in the sidebar shows oa-admin turned on, with its tools.",
  },
  {
    "agent": "OpenCode",
    "code": "{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "oa-admin": {
      "type": "remote",
      "url": "https://api.open-artifacts.app/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:OA_TOKEN}"
      }
    }
  }
}",
    "file": "opencode.json",
    "hint": "Export OA_TOKEN before you start OpenCode. If it isn't set, OpenCode sends an empty token.",
    "language": "json",
    "reload": "Restart OpenCode. It reads its config when it starts.",
    "variant": "token",
    "verify": "Run \`opencode mcp list\`. It shows oa-admin as connected.",
  },
  {
    "agent": "Generic",
    "code": "{
  "mcpServers": {
    "oa-admin": {
      "type": "http",
      "url": "https://api.open-artifacts.app/mcp",
      "headers": {
        "Authorization": "Bearer <YOUR_TOKEN>"
      }
    }
  }
}",
    "hint": "If your client can read the token from a file or an environment variable, use that. If it can't, replace <YOUR_TOKEN> with your token and keep this file out of git.",
    "language": "json",
    "reload": "Restart your AI agent, or reload its MCP servers.",
    "variant": "token",
    "verify": "Ask your AI agent to list the oa-admin tools. You should see get_world.",
  },
]
`;

