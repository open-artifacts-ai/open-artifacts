{
  "name": "@oa/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    },
    "./provisioning": {
      "types": "./dist/provisioning/index.d.ts",
      "import": "./dist/provisioning/index.js",
      "default": "./dist/provisioning/index.js"
    },
    "./provisioning/slugs": {
      "types": "./dist/provisioning/slugs.d.ts",
      "import": "./dist/provisioning/slugs.js",
      "default": "./dist/provisioning/slugs.js"
    },
    "./provisioning/alerts": {
      "types": "./dist/provisioning/alerts.d.ts",
      "import": "./dist/provisioning/alerts.js",
      "default": "./dist/provisioning/alerts.js"
    },
    "./provisioning/enums": {
      "types": "./dist/provisioning/enum-values.d.ts",
      "import": "./dist/provisioning/enum-values.js",
      "default": "./dist/provisioning/enum-values.js"
    },
    "./provisioning/errors": {
      "types": "./dist/provisioning/error-codes.d.ts",
      "import": "./dist/provisioning/error-codes.js",
      "default": "./dist/provisioning/error-codes.js"
    },
    "./provisioning/state": {
      "types": "./dist/provisioning/state.d.ts",
      "import": "./dist/provisioning/state.js",
      "default": "./dist/provisioning/state.js"
    },
    "./provisioning/system": {
      "types": "./dist/provisioning/system.d.ts",
      "import": "./dist/provisioning/system.js",
      "default": "./dist/provisioning/system.js"
    },
    "./provisioning/workflow": {
      "types": "./dist/provisioning/workflow.d.ts",
      "import": "./dist/provisioning/workflow.js",
      "default": "./dist/provisioning/workflow.js"
    },
    "./provisioning/fakes": {
      "types": "./dist/provisioning/fakes.d.ts",
      "import": "./dist/provisioning/fakes.js",
      "default": "./dist/provisioning/fakes.js"
    },
    "./provisioning/fixtures": {
      "types": "./dist/provisioning/fixtures.d.ts",
      "import": "./dist/provisioning/fixtures.js",
      "default": "./dist/provisioning/fixtures.js"
    },
    "./provisioning/mocks": {
      "types": "./dist/mocks/provisioning.d.ts",
      "import": "./dist/mocks/provisioning.js",
      "default": "./dist/mocks/provisioning.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "msw": "^2.15.0"
  },
  "peerDependencies": {
    "msw": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  }
}
