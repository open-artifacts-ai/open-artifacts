{
  "name": "@oa/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./provisioning": {
      "types": "./dist/provisioning/index.d.ts",
      "import": "./dist/provisioning/index.js"
    },
    "./mocks": {
      "types": "./dist/mocks/index.d.ts",
      "import": "./dist/mocks/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "msw": "^2.15.0"
  },
  "peerDependencies": {
    "msw": "^2.15.0"
  },
  "peerDependenciesMeta": {
    "msw": {
      "optional": true
    }
  }
}
