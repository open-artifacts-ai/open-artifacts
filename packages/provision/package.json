{
  "name": "@oa/provision",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "workerd": "./src/names.ts",
      "import": "./dist/names.js",
      "default": "./dist/names.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @oa/shared build && tsc -b",
    "test": "pnpm --filter @oa/shared build && vitest run",
    "typecheck": "pnpm --filter @oa/shared build && tsc --noEmit -p tsconfig.typecheck.json"
  },
  "devDependencies": {
    "@types/node": "^22.20.5"
  },
  "dependencies": {
    "@oa/shared": "workspace:*"
  }
}
