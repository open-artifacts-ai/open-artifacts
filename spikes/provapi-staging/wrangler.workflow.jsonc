// Spike Workflow host (S3): staging only, throwaway, one per run. Defines
// Workflow oa-s-spike-<run> (class SpikeWorkflow) that the caller Worker
// binds cross-script. No route, workers.dev, preview URL or cron.
{
  "name": "oa-s-spike-{{RUN_ID}}-wf",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "vars": { "ROLE": "host" },
  "workflows": [
    {
      "binding": "WF",
      "name": "oa-s-spike-{{RUN_ID}}",
      "class_name": "SpikeWorkflow"
    }
  ]
}
